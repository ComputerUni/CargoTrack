@{
    ViewData["Title"] = "Kargolarımız";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex-1 flex flex-col min-w-0 min-h-screen">

    @await Component.InvokeAsync("_AdminCargoListHeader")

    <main class="flex-1 p-8 overflow-y-auto bg-gray-50">

        @await Component.InvokeAsync("_AdminCargoListFilters")

        @await Component.InvokeAsync("_AdminCargoListResultCountExport")

        @await Component.InvokeAsync("_AdminCargoListTable", new { cargos = Model })

    </main>
</div>