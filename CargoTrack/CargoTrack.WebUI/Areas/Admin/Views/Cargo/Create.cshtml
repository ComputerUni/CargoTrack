@model CreateCargoDto

@{
    ViewData["Title"] = "Yeni Kargo Tanımla";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex-1 flex flex-col min-w-0 min-h-screen bg-gray-50 p-6 md:p-8">
    <div class="max-w mx-auto w-full">

        <div class="bg-white rounded-xl border border-outline-variant p-6 shadow-sm">
            <div class="border-b border-outline-variant pb-4 mb-6">
                <h2 class="text-lg font-bold text-on-background">Yeni Kargo Tanımla</h2>
                <p class="text-xs text-on-surface-variant mt-0.5">Sisteme yeni bir kargo ekleyin.</p>
            </div>

            <form method="post" asp-area="Admin" asp-controller="Cargo" asp-action="Create" class="space-y-6">

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                    <div>
                        <label asp-for="Weight" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">AĞIRLIK (KG)</label>
                        <input type="number" step="0.01" asp-for="Weight" placeholder="Örn: 2.5"
                               class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container" />
                        <span asp-validation-for="Weight" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Length" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">UZUNLUK (CM)</label>
                        <input type="number" step="0.01" asp-for="Length" placeholder="Örn: 30"
                               class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container" />
                        <span asp-validation-for="Length" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Width" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">GENİŞLİK (CM)</label>
                        <input type="number" step="0.01" asp-for="Width" placeholder="Örn: 20"
                               class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container" />
                        <span asp-validation-for="Width" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Height" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">YÜKSEKLİK (CM)</label>
                        <input type="number" step="0.01" asp-for="Height" placeholder="Örn: 15"
                               class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container" />
                        <span asp-validation-for="Height" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="CargoType" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">KARGO TİPİ</label>
                    <select asp-for="CargoType" asp-items="@ViewBag.CargoTypes"
                            class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container">
                        <option disabled selected value="">--- Kargo Tipi Seçiniz ---</option>
                    </select>
                    <span asp-validation-for="CargoType" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="SenderId" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">GÖNDEREN</label>
                        <select asp-for="SenderId" asp-items="@ViewBag.Users"
                                class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container">
                            <option disabled selected value="">--- Göndericiyi Seçiniz ---</option>
                        </select>
                        <span asp-validation-for="SenderId" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="ReceiverId" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">ALICI</label>
                        <select asp-for="ReceiverId" asp-items="@ViewBag.Users"
                                class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container">
                            <option disabled selected value="">--- Alıcıyı Seçiniz ---</option>
                        </select>
                        <span asp-validation-for="ReceiverId" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="OriginBranchId" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">ÇIKIŞ ŞUBESİ</label>
                        <select asp-for="OriginBranchId" asp-items="@ViewBag.Branches"
                                class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container">
                            <option disabled selected value="">--- Çıkış Şubesini Seçiniz ---</option>
                        </select>
                        <span asp-validation-for="OriginBranchId" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="DestinationBranchId" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">VARIŞ ŞUBESİ</label>
                        <select asp-for="DestinationBranchId" asp-items="@ViewBag.Branches"
                                class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container">
                            <option disabled selected value="">--- Varış Şubesini Seçiniz ---</option>
                        </select>
                        <span asp-validation-for="DestinationBranchId" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                    </div>
                </div>

                <div class="flex items-center gap-3 pt-4 border-t border-outline-variant">
                    <button type="submit"
                            class="px-5 py-2.5 rounded-lg text-sm font-bold text-white transition-opacity hover:opacity-95"
                            style="background:#001e3c;">
                        Kargoyu Kaydet
                    </button>
                    <a asp-area="Admin" asp-controller="Cargo" asp-action="Index"
                       class="px-4 py-2.5 rounded-lg text-sm font-semibold border border-outline-variant hover:bg-surface-container-low transition-colors"
                       style="color:#43474e;">
                        Vazgeç
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>