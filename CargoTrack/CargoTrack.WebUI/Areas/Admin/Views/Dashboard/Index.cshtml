@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex-1 flex flex-col min-w-0">
    <header class="bg-white border-b border-outline-variant px-8 py-4 flex items-center justify-between sticky top-0 z-10">
        <div>
            <h1 class="font-bold text-xl text-on-background">Dashboard</h1>
            <p style="color:#43474e;font-size:13px;">@DateTime.Now.ToString("dd MMM yyyy, dddd")</p>
        </div>
        <div class="flex items-center gap-3">
            <button class="relative p-2 rounded-lg hover:bg-surface-container-low transition-colors">
                <span class="material-symbols-outlined text-on-surface-variant">notifications</span>
                <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full" style="background:#fd8b00;"></span>
            </button>
            <form asp-route-area="" asp-controller="Login" asp-action="Logout" method="post">
                <button class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold transition-colors" style="background:#001e3c;color:#fff;">
                    <span class="material-symbols-outlined" style="font-size:16px;">logout</span>Çıkış
                </button>
            </form>
        </div>
    </header>
    <main class="flex-1 p-8 overflow-y-auto">

        @await Component.InvokeAsync("_AdminDashboardKpiCards")

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-8">

            @await Component.InvokeAsync("_AdminDashboardWeeklyTrafficChart")

            @await Component.InvokeAsync("_AdminDashboardStatusDonut")

        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-8">

            @await Component.InvokeAsync("_AdminDashboardTop5Branches")

            @await Component.InvokeAsync("_AdminDashboardSecondaryKpi")

        </div>

        @await Component.InvokeAsync("_AdminDashboardRecentCargoTable")

    </main>
</div>

