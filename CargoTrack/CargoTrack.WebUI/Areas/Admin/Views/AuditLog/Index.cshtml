@using CargoTrack.DTO.DTOs.AuditLogDtos
@model List<ResultAuditLogDto>

@{
    ViewData["Title"] = "Loglar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<div class="w-full p-8 space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-bold text-on-background">Log Yönetimi</h2>
            <p class="text-xs text-on-surface-variant mt-0.5">Sistemde gerçekleşen tüm işlem, durum değişikliği ve kullanıcı hareketlerini bu sayfadan inceleyebilirsiniz.</p>
        </div>
        <span class="inline-flex items-center px-4 py-2 rounded-lg text-xs font-bold text-slate-700 bg-white border border-outline-variant shadow-sm">
            Toplam Kayıt: @(Model?.Count ?? 0)
        </span>
    </div>

    <div class="bg-white rounded-xl border border-outline-variant overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead style="background:#f8f9ff;">
                    <tr style="border-bottom:2px solid #e5eeff;">
                        <th class="text-left py-3.5 px-4 font-semibold text-xs tracking-wider" style="color:#43474e;">#</th>
                        <th class="text-left py-3.5 px-4 font-semibold text-xs tracking-wider" style="color:#43474e;">TARİH</th>
                        <th class="text-left py-3.5 px-4 font-semibold text-xs tracking-wider" style="color:#43474e;">KULLANICI</th>
                        <th class="text-left py-3.5 px-4 font-semibold text-xs tracking-wider" style="color:#43474e;">İŞLEM TÜRÜ</th>
                        <th class="text-left py-3.5 px-4 font-semibold text-xs tracking-wider" style="color:#43474e;">VARLIK / TABLO</th>
                        <th class="text-left py-3.5 px-4 font-semibold text-xs tracking-wider" style="color:#43474e;">AÇIKLAMA</th>
                        <th class="text-left py-3.5 px-4 font-semibold text-xs tracking-wider" style="color:#43474e;">DEĞİŞİKLİK ÖZETİ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            count++;
                            var (badgeBg, badgeText) = item.ActionType?.ToLower() switch
                            {
                                "create" or "ekleme" => ("#e8f5e9", "#2e7d32"),
                                "update" or "güncelleme" => ("#e5eeff", "#001e3c"),
                                "delete" or "silme" => ("#ffebee", "#ba1a1a"),
                                "statuschange" or "durum değişikliği" => ("#fff3e0", "#e65100"),
                                _ => ("#f5f5f5", "#43474e")
                            };

                            <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors">
                                <td class="py-3.5 px-4 font-semibold text-slate-500">@count</td>
                                <td class="py-3.5 px-4 whitespace-nowrap text-xs font-medium text-slate-600">
                                    @item.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td class="py-3.5 px-4 font-bold text-on-background whitespace-nowrap">
                                    @(string.IsNullOrWhiteSpace(item.UserFullName) ? "Sistem" : item.UserFullName)
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold"
                                          style="background:@badgeBg; color:@badgeText;">
                                        @item.ActionType
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-medium text-slate-700 bg-slate-100">
                                        @item.EntityName
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-xs text-slate-700 max-w-xs break-words">
                                    @item.Description
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    @if (!string.IsNullOrEmpty(item.OldValue) || !string.IsNullOrEmpty(item.NewValue))
                                    {
                                        <div class="inline-flex items-center gap-1.5 text-xs font-medium">
                                            <span class="line-through px-2 py-0.5 rounded text-rose-700" style="background:#ffebee;">
                                                @(item.OldValue ?? "-")
                                            </span>
                                            <span class="text-slate-400">→</span>
                                            <span class="px-2 py-0.5 rounded font-bold text-emerald-800" style="background:#e8f5e9;">
                                                @(item.NewValue ?? "-")
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 text-xs">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-xs text-slate-500">
                                Kayıtlı işlem günlüğü (audit log) bulunamadı.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>