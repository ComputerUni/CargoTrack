@model CreateBranchDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex-1 flex flex-col min-w-0 min-h-screen bg-gray-50 p-6 md:p-8">
    <div class="max-w mx-auto w-full">

        <div class="w-full bg-white rounded-xl border border-outline-variant p-6 shadow-sm">
            <div class="border-b border-outline-variant pb-4 mb-6">
                <h2 class="text-lg font-bold text-on-background">Yeni Şube Tanımla</h2>
                <p class="text-xs text-on-surface-variant mt-0.5">Sisteme yeni bir acente veya dağıtım merkezi şubesi ekleyin.</p>
            </div>
            <form method="post" asp-area="Admin" asp-controller="Branch" asp-action="Create" class="space-y-5">
                <div>
                    <label asp-for="Name" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">ŞUBE ADI</label>
                    <input type="text" asp-for="Name" placeholder="Örn: İstanbul Anadolu Şubesi"
                           class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container" />
                    <span asp-validation-for="Name" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="CityId" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">BAĞLI OLDUĞU İL</label>
                    <select asp-for="CityId" asp-items="@ViewBag.cities"
                            class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container">
                        <option disabled selected value="">--- Şehir Seçiniz ---</option>
                    </select>
                    <span asp-validation-for="CityId" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                </div>

                <div class="flex items-center gap-3 pt-4 border-t border-outline-variant">
                    <button type="submit"
                            class="px-5 py-2.5 rounded-lg text-sm font-bold text-white transition-opacity hover:opacity-95"
                            style="background:#001e3c;">
                        Şubeyi Kaydet
                    </button>
                    <a asp-area="Admin" asp-controller="Branch" asp-action="Index"
                       class="px-4 py-2.5 rounded-lg text-sm font-semibold border border-outline-variant hover:bg-surface-container-low transition-colors"
                       style="color:#43474e;">
                        Vazgeç
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>