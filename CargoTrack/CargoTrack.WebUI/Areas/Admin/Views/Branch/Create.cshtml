@model CreateBranchDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int count = 0;
}

<h3>Yeni Şube Oluştur</h3>

<form method="post" asp-action="Create" asp-controller="Branch">
    <div class="mt-3">
        <label>Şube İsmi</label>
        <input type="text" class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>
    <div class="mt-3">
        <label>Şehir</label>
        <select asp-for="CityId" class="form-control" asp-items="@ViewBag.cities">
            <option disabled selected>--- Şehri Seçiniz ---</option>
        </select>
    </div>
    <div class="mt-3">
        <button class="btn btn-outline-success">Kaydet</button>
    </div>
</form>