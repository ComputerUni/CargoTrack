@model List<ResultBranchDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int count = 0;
}

<h3>Şubelerimiz</h3>

<table class="table table-bordered table-hover">
    <tr>
        <th>#</th>
        <th>Şube İsmi</th>
        <th>Şehir</th>
        <th>İşlemler</th>
    </tr>


    @foreach (var item in Model)
    {
        count++;
        <tr>
            <th>@count</th>
            <td>@item.Name</td>
            <td>@item.City.Name</td>
            <td>
                <a href="/Admin/Branch/Delete/@item.Id" class="btn btn-outline-danger" onclick="return confirm('Silmek istediğinize emin misiniz ?')">Sil</a>
                <a href="/Admin/Branch/Update/@item.Id" class="btn btn-outline-warning">Güncelle</a>
            </td>
        </tr>
    }

</table>

<div class="mt-3">
    <a href="/Admin/Branch/Create" class="btn btn-outline-info">Yeni Şube</a>
</div>