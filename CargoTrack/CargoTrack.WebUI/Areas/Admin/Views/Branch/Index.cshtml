@model List<ResultBranchDto>

@{
    ViewData["Title"] = "Şubelerimiz";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex-1 flex flex-col min-w-0">

    @await Component.InvokeAsync("_AdminBranchHeader")

    <main class="flex-1 p-8 overflow-y-auto">

        @await Component.InvokeAsync("_AdminBranchSummaryCards")

        @await Component.InvokeAsync("_AdminBranchFilters")

        @await Component.InvokeAsync("_AdminBranchTable", new { branches = Model })
    </main>
</div>