@model UpdateAboutDto
@{
    ViewData["Title"] = "Update";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form method="post" asp-action="Update" asp-controller="About">
    <input type="hidden" asp-for="Id" />
    <div class="mt-3">
        <label>Başlık</label>
        <input type="text" class="form-control" asp-for="Title" />
        <span class="text-danger" asp-validation-for="Title"></span>
    </div>
    <div class="mt-3">
        <label>Açıklama</label>
        <textarea class="form-control" rows="3" asp-for="Description"></textarea>
        <span class="text-danger" asp-validation-for="Description"></span>
    </div>
    <div class="mt-3">
        <label>Görsel Url</label>
        <input type="text" class="form-control" asp-for="ImageUrl" />
        <span class="text-danger" asp-validation-for="ImageUrl"></span>
    </div>
    <div class="mt-3">
        <button class="btn btn-outline-warning">Güncelle</button>
    </div>
</form>
