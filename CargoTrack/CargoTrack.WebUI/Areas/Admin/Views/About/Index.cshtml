@model List<ResultAboutDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int count = 0;
}


@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Henüz Hakkımızda Bilgisi Oluşturulmamış</div>
    <div class="mt-3">
        <a href="/Admin/About/Create" class="btn btn-outline-info">Yeni Hakkımızda</a>
    </div>
}
else
{
    <table class="table table-bordered table-hover">
        <tr>
            <th>#</th>
            <th>Görsel</th>
            <th>Başlık</th>
            <th>Açıklama</th>
            <th>İşlemler</th>
        </tr>


        @foreach (var item in Model)
        {
            count++;
            <tr>
                <th>@count</th>
                <td><img src="@item.ImageUrl" style="height:150px;width:250px; border-radius:5px;" /></td>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>
                    <a href="/Admin/About/Delete/@item.Id" class="btn btn-outline-danger" onclick="return confirm('Silmek istediğinize emin misiniz ?')">Sil</a>
                    <a href="/Admin/About/Update/@item.Id" class="btn btn-outline-warning">Güncelle</a>
                </td>
            </tr>
        }

    </table>
}
