@model List<RoleAssingDto>
@{
    ViewData["Title"] = "GetUserForRoleAssign";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3><strong>@ViewBag.fullName</strong> Hoş Geldiniz</h3>
<div class="container-fluid">
    <span class="text-primary">Rol atama işlemlerini buradan yönetebilirsiniz.</span>
</div>


<form method="post">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="container-fluid align-items-center justify-content-center mt-3">
            <input type="checkbox" asp-for="@Model[i].RoleExist" />
            <label>@Model[i].RoleName</label>

            <input type="hidden" asp-for="@Model[i].RoleName" />
            <input type="hidden" asp-for="@Model[i].RoleId" />
            <input type="hidden" asp-for="@Model[i].UserId" />
        </div>
    }

    <div class="container mt-3">
        <button class="btn btn-outline-dark">Rol Ata</button>
    </div>

</form>