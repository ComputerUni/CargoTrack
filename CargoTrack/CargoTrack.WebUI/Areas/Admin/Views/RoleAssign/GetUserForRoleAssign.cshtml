@model List<RoleAssingDto>
@{
    ViewData["Title"] = "Rol Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="p-6 md:p-8 max-w-3xl mx-auto space-y-6">
    <div>
        <a href="javascript:history.back()" class="inline-flex items-center gap-1 text-xs font-medium text-gray-500 hover:text-gray-900 transition-colors mb-2">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Kullanıcı Listesine Dön</span>
        </a>
        <h2 class="text-2xl font-bold text-gray-900">Yetkilendirme Ayarları</h2>
        <p class="text-sm text-gray-500 mt-1">
            <strong class="text-blue-600 font-semibold">@ViewBag.fullName</strong> kullanıcısının rollerini ve şube atamasını belirleyin.
        </p>
    </div>

    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <form method="post" class="space-y-6">
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">Rol Seçimi</h3>

                <div class="space-y-3">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var isManager = Model[i].RoleName == "Manager";
                        var checkboxId = $"role_{i}";

                        <div class="border border-gray-200 rounded-xl p-4 flex items-center justify-between hover:border-gray-300 transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-500">
                                    <span class="material-symbols-outlined text-[20px]">verified_user</span>
                                </div>
                                <div>
                                    <label for="@checkboxId" class="font-semibold text-gray-900 text-sm block cursor-pointer">@Model[i].RoleName</label>
                                    <span class="text-xs text-gray-500">Bu rolün yetkilerini kullanıcıya atar.</span>
                                </div>
                            </div>

                            <input type="checkbox"
                                   asp-for="@Model[i].RoleExist"
                                   id="@checkboxId"
                                   class="w-5 h-5 rounded text-blue-600 border-gray-300 focus:ring-blue-500 @(isManager ? "manager-trigger" : "") cursor-pointer" />

                            <input type="hidden" asp-for="@Model[i].RoleName" />
                            <input type="hidden" asp-for="@Model[i].RoleId" />
                            <input type="hidden" asp-for="@Model[i].UserId" />
                        </div>

                        @if (isManager)
                        {
                            <div id="branchSelectionArea" class="p-4 bg-amber-50/50 border border-amber-200/80 rounded-xl space-y-2 @(Model[i].RoleExist ? "" : "hidden")">
                                <div class="flex items-center gap-1.5 text-amber-900 font-semibold text-xs">
                                    <span class="material-symbols-outlined text-[18px] text-amber-600">store</span>
                                    <span>YÖNETİLECEK ŞUBE SEÇİMİ</span>
                                </div>
                                <p class="text-xs text-amber-700">Manager rolündeki kullanıcı sadece seçilen şubenin kargolarını yönetebilir.</p>
                                <select name="branchId" asp-items="@ViewBag.Branches"
                                        class="w-full h-11 px-3.5 rounded-xl border border-gray-300 bg-white text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
                                    <option value="">--- Şube Seçiniz ---</option>
                                </select>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                <a href="javascript:history.back()" class="px-4 py-2.5 rounded-xl border border-gray-200 text-gray-700 hover:bg-gray-50 text-sm font-medium transition-colors">
                    İptal
                </a>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-gray-900 hover:bg-black text-white text-sm font-medium shadow-sm transition-colors flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">check</span>
                    <span>Rolleri Güncelle</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const managerTrigger = document.querySelector(".manager-trigger");
        const branchArea = document.getElementById("branchSelectionArea");

        if (managerTrigger && branchArea) {
            managerTrigger.addEventListener("change", function() {
                if (this.checked) {
                    branchArea.classList.remove("hidden");
                } else {
                    branchArea.classList.add("hidden");
                }
            });
        }
    });
</script>