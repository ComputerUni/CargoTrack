@model List<ResultUserDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int count = 0;
}

<h1>Kullanıcı Listesi</h1>

<table class="table table-bordered table-hover">
    <tr>
        <th>#</th>
        <th>Ad Soyad</th>
        <th>Email</th>
        <th>Kullanıcı</th>
        <th>Roller</th>
        <th>İşlemler</th>
    </tr>

    @foreach(var item in Model)
    {
        count++;
        <tr>
            <th>@count</th>
            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>@item.UserName</td>
            <td>
                @foreach(var role in item.Roles)
                {
                    <span class="badge bg-danger text-white">@role</span>
                }
            </td>
            <td>
                <a href="/Admin/RoleAssign/GetUserForRoleAssign/@item.Id" class="btn btn-outline-secondary">Rol Ata</a>
            </td>
        </tr>
    }
</table>

