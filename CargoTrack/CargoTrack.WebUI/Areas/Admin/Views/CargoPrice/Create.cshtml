@model CreateCargoPriceDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="w-full bg-white rounded-xl border border-outline-variant p-6 shadow-sm">
    <div class="border-b border-outline-variant pb-4 mb-6">
        <h2 class="text-lg font-bold text-on-background">Yeni Kargo Ücreti Tanımla</h2>
        <p class="text-xs text-on-surface-variant mt-0.5">Sisteme yeni bir kargo ücretlendirmesi ekleyin.</p>
    </div>
    <form method="post" asp-area="Admin" asp-controller="CargoPrice" asp-action="Create" class="space-y-5">
        <div>
            <label asp-for="MinWeight" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">MİNİMUM AĞIRLIK</label>
            <input type="text" asp-for="MinWeight" placeholder="Örn: İstanbul Anadolu Şubesi"
                   class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container" />
            <span asp-validation-for="MinWeight" class="text-xs font-medium text-rose-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="MaxWeight" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">MAKSİMUM AĞIRLIK</label>
            <input type="text" asp-for="MaxWeight" placeholder="Örn: İstanbul Anadolu Şubesi"
                   class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container" />
            <span asp-validation-for="MaxWeight" class="text-xs font-medium text-rose-600 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="DesiCoefficient" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">DESİ KATSAYISI</label>
            <input type="text" asp-for="DesiCoefficient" placeholder="Örn: 0555 555 00 00"
                   class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container" />
            <span asp-validation-for="DesiCoefficient" class="text-xs font-medium text-rose-600 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="CargoType" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">KARGO TÜRÜ</label>
            <select asp-for="CargoType" asp-items="@ViewBag.CargoTypes"
                    class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container">
                <option disabled selected value="">--- Kargo Tipi Seçiniz ---</option>
            </select>
            <span asp-validation-for="CargoType" class="text-xs font-medium text-rose-600 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="AdditionalServicePrice" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">EK HİZMET ÜCRETİ</label>
            <input type="text" asp-for="AdditionalServicePrice" placeholder="Örn: 0555 555 00 00"
                   class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container" />
            <span asp-validation-for="AdditionalServicePrice" class="text-xs font-medium text-rose-600 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="BasePrice" class="block text-xs font-semibold mb-1.5" style="color:#43474e;">TEMEL FİYAT</label>
            <input type="text" asp-for="BasePrice" placeholder="Örn: 0555 555 00 00"
                   class="w-full px-3.5 py-2.5 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none focus:border-primary-container" />
            <span asp-validation-for="BasePrice" class="text-xs font-medium text-rose-600 mt-1 block"></span>
        </div>
        <div class="flex items-center gap-3">
            <input type="checkbox" asp-for="IsIntercity"
                   class="w-4 h-4 rounded border-outline-variant" />
            <label asp-for="IsIntercity" class="text-xs font-semibold" style="color:#43474e;">
                ŞEHİRLERARASI
            </label>
        </div>
        <span asp-validation-for="IsIntercity" class="text-xs font-medium text-rose-600 mt-1 block"></span>

        <div class="flex items-center gap-3 pt-4 border-t border-outline-variant">
            <button type="submit"
                    class="px-5 py-2.5 rounded-lg text-sm font-bold text-white transition-opacity hover:opacity-95"
                    style="background:#001e3c;">
                Kargo Ücretini Kaydet
            </button>
            <a asp-area="Admin" asp-controller="CargoPrice" asp-action="Index"
               class="px-4 py-2.5 rounded-lg text-sm font-semibold border border-outline-variant hover:bg-surface-container-low transition-colors"
               style="color:#43474e;">
                Vazgeç
            </a>
        </div>
    </form>
</div>