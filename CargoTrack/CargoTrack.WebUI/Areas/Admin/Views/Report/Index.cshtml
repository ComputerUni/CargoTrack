<div class="flex-1 flex flex-col min-w-0">
    <header class="bg-white border-b border-outline-variant px-8 py-4 flex items-center justify-between sticky top-0 z-10">
        <div>
            <h1 class="font-bold text-xl text-on-background">Performans ve Operasyon Raporları</h1>
            <p style="color:#43474e;font-size:13px;">Şube SLA başarı oranları, personel teslimat istatistikleri ve gecikme analizleri</p>
        </div>
    </header>

    <main class="flex-1 p-8 overflow-y-auto">

        @await Component.InvokeAsync("_AdminReportKpiSummary")

        @await Component.InvokeAsync("_AdminReportBranchPerformanceTable")

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            @await Component.InvokeAsync("_AdminReportExceptionReasonAnalysis")

            @await Component.InvokeAsync("_AdminReportCourierPerformance")

        </div>
    </main>
</div>
