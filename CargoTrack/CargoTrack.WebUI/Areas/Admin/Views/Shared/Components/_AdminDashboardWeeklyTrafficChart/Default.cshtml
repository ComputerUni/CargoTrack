@using CargoTrack.DTO.DTOs.AdminDashboardDtos
@model List<AdminDashboardWeeklyTrafficDto>

<div class="lg:col-span-2 bg-white rounded-xl border border-outline-variant p-6">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h3 class="font-bold text-lg text-on-background">Son 7 Günlük Kargo Trafiği</h3>
            <p style="color:#43474e;font-size:13px;">Gelen ve gönderilen kargo adetleri</p>
        </div>
        <div class="flex items-center gap-4 text-sm">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block" style="background:#001e3c;"></span>Gelen</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block" style="background:#fd8b00;"></span>Gönderilen</span>
        </div>
    </div>
    <!-- Simple SVG bar chart -->
    <div class="flex items-end gap-2 h-48 px-2">
        @foreach(var day in Model)
        {
            <div class="flex-1 flex flex-col items-center gap-1">
                <div class="w-full flex gap-1 items-end" style="height:160px;">
                    <div class="flex-1 chart-bar" style="height:@(day.IncomingPercent)%;background:#001e3c;border-radius:4px 4px 0 0;display:flex;align-items:flex-start;justify-content:center;">
                        @if (day.IncomingCargo > 0)
                        {
                            <span style="font-size:10px;color:white;font-weight:600;padding-top:2px;">@day.IncomingCargo</span>
                        }
                    </div>
                    <div class="flex-1 chart-bar" style="height:@(day.OutgoingPercent)%;background:#fd8b00;border-radius:4px 4px 0 0;display:flex;align-items:flex-start;justify-content:center;">
                        @if (day.OutgoingCargo > 0)
                        {
                            <span style="font-size:10px;color:white;font-weight:600;padding-top:2px;">@day.OutgoingCargo</span>
                        }
                    </div>
                </div>
                <span style="font-size:11px;color:#43474e;">@day.Day</span>
            </div>
        }
       
    </div>
</div>
