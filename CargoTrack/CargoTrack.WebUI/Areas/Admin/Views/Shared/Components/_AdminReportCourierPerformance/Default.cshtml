@using CargoTrack.DTO.DTOs.ReportDtos
@model List<CourierPerformanceDto>

<div class="bg-white rounded-xl border border-outline-variant p-6">
    <h3 class="font-bold text-lg text-on-background mb-3">En Yüksek Performanslı Kuryeler</h3>
    <div class="space-y-3">
        @{
            int rank = 1;
        }
        @foreach (var item in Model)
        {
            var badgeBg = rank switch
            {
                1 => "bg-amber-100 text-amber-800",
                2 => "bg-slate-200 text-slate-800",
                3 => "bg-orange-100 text-orange-800",
                _ => "bg-slate-100 text-slate-600"
            };

            <div class="flex items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs @badgeBg">
                        @rank
                    </div>
                    <div>
                        <div class="font-semibold text-slate-800">
                            @item.EmployeeName (@item.BranchName)
                        </div>
                        <div class="text-xs text-slate-500">
                            @item.DeliveredCount teslimat • @item.FailedCount başarısız deneme
                        </div>
                    </div>
                </div>
                <span class="font-bold text-green-700 text-sm">%@item.SuccessRate SLA</span>
            </div>

            rank++;
        }
    </div>
</div>