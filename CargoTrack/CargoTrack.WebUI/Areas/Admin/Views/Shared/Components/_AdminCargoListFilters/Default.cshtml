@using CargoTrack.Business.Extensions
@using CargoTrack.Entity.Entities.Enums
<form method="get"
asp-area="Admin"
      asp-controller="Cargo"
      asp-action="Index"
      class="bg-white rounded-xl border border-outline-variant p-4 mb-5 flex flex-wrap gap-3 items-end">

    <div class="flex-1 min-w-56">
        <label class="block text-xs font-semibold mb-1" style="color:#43474e;">ARAMA</label>
        <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline" style="font-size:18px;">search</span>
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Takip no, müşteri adı veya şube ara..."
                   class="w-full pl-9 pr-4 py-2 border border-outline-variant rounded-lg text-sm focus:outline-none" />
        </div>
    </div>

    <div class="w-48">
        <label class="block text-xs font-semibold mb-1" style="color:#43474e;">DURUM</label>
        <select name="status"
                onchange="this.form.submit()"
                class="w-full px-3 py-2 border border-outline-variant rounded-lg text-sm bg-white focus:outline-none cursor-pointer">
            <option value="">Tüm Durumlar</option>
            @foreach (CargoStatus statusEnum in Enum.GetValues(typeof(CargoStatus)))
            {
                var intVal = (int)statusEnum;
                var isSelected = (ViewBag.Status as string) == intVal.ToString();
                <option value="@intVal" selected="@(isSelected ? "selected" : null)">
                    @statusEnum.GetDisplayName()
                </option>
            }
        </select>
    </div>

    <button type="submit" class="px-5 py-2 rounded-lg text-sm font-semibold text-white transition-opacity hover:opacity-90" style="background:#001e3c;">
        Filtrele
    </button>

    @if (!string.IsNullOrEmpty(ViewBag.Search) || !string.IsNullOrEmpty(ViewBag.Status))
    {
        <a asp-action="Index" class="px-3 py-2 rounded-lg text-sm font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 transition-colors flex items-center justify-center" title="Filtreleri Temizle">
            <span class="material-symbols-outlined text-[18px]">close</span>
        </a>
    }
</form>