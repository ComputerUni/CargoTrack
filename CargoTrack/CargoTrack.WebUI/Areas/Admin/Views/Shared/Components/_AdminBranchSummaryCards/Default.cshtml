@using CargoTrack.DTO.DTOs.AdminBranchDtos
@model AdminBranchSummaryDto

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white p-5 rounded-xl border border-outline-variant shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider" style="color:#43474e;">Toplam Şube</div>
        <div class="text-2xl font-bold mt-1 text-on-background">@Model.TotalBranches</div>
        <div class="text-xs text-slate-500 mt-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-[15px] text-blue-600">store</span>
            <span>Kayıtlı tüm şubeler</span>
        </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-outline-variant shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider" style="color:#43474e;">Aktif Şube</div>
        <div class="text-2xl font-bold mt-1 text-on-background">@Model.ActiveBranches</div>
        <div class="text-xs text-emerald-700 mt-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-[15px]">check_circle</span>
            <span>Hizmete açık</span>
        </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-outline-variant shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider" style="color:#43474e;">Toplam Personel</div>
        <div class="text-2xl font-bold mt-1 text-on-background">@Model.TotalEmployees</div>
        <div class="text-xs text-slate-500 mt-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-[15px] text-amber-600">badge</span>
            <span>Şube başı ort. @Model.AvgEmployeePerBranch</span>
        </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-outline-variant shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider" style="color:#43474e;">Aktif Kargo Hacmi</div>
        <div class="text-2xl font-bold mt-1 text-on-background">@Model.ActiveCargos</div>
        <div class="text-xs text-slate-500 mt-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-[15px] text-indigo-600">local_shipping</span>
            <span>Dağıtım / Sevkiyat aşamasında</span>
        </div>
    </div>
</div>