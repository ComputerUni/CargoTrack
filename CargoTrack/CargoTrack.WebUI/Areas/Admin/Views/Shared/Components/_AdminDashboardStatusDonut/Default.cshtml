@using System.Globalization
@using CargoTrack.DTO.DTOs.AdminDashboardDtos
@model AdminDashboardStatusDonutDto

@{
    var ci = CultureInfo.InvariantCulture;

    double p1 = Model.DeliveredPercent;
    double p2 = p1 + Model.ActivePercent;
    double p3 = p2 + Model.InTransferPercent;
    double p4 = p3 + Model.DelayedPercent;

    string p1Str = p1.ToString("0.0", ci);
    string p2Str = p2.ToString("0.0", ci);
    string p3Str = p3.ToString("0.0", ci);
    string p4Str = p4.ToString("0.0", ci);

    string gradientStyle = Model.TotalCargo > 0
        ? $"conic-gradient(#2e7d32 0% {p1Str}%, #fd8b00 {p1Str}% {p2Str}%, #001e3c {p2Str}% {p3Str}%, #ba1a1a {p3Str}% {p4Str}%, #43474e {p4Str}% 100%)"
        : "#e0e0e0";
}

<div class="bg-white rounded-xl border border-outline-variant p-6">
    <h3 class="font-bold text-lg text-on-background mb-4">Durum Dağılımı</h3>

    <div class="flex justify-center mb-5">
        <div style="width:140px;height:140px;border-radius:50%;background:@gradientStyle;position:relative;">
            <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:90px;height:90px;background:white;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;">
                <span style="font-size:22px;font-weight:700;color:#0b1c30;">@Model.TotalCargo</span>
                <span style="font-size:10px;color:#43474e;">toplam</span>
            </div>
        </div>
    </div>

    <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between text-sm">
            <span class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full" style="background:#2e7d32;display:inline-block;"></span>
                Teslim Edildi
            </span>
            <span class="font-semibold">@Model.Delivered (@Model.DeliveredPercent%)</span>
        </div>
        <div class="flex items-center justify-between text-sm">
            <span class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full" style="background:#fd8b00;display:inline-block;"></span>
                Aktif
            </span>
            <span class="font-semibold">@Model.Active (@Model.ActivePercent%)</span>
        </div>
        <div class="flex items-center justify-between text-sm">
            <span class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full" style="background:#001e3c;display:inline-block;"></span>
                Transfer
            </span>
            <span class="font-semibold">@Model.InTransfer (@Model.InTransferPercent%)</span>
        </div>
        <div class="flex items-center justify-between text-sm">
            <span class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full" style="background:#ba1a1a;display:inline-block;"></span>
                Geciken
            </span>
            <span class="font-semibold">@Model.Delayed (@Model.DelayedPercent%)</span>
        </div>
        <div class="flex items-center justify-between text-sm">
            <span class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full" style="background:#43474e;display:inline-block;"></span>
                Diğer
            </span>
            <span class="font-semibold">@Model.Other (@Model.OtherPercent%)</span>
        </div>
    </div>
</div>