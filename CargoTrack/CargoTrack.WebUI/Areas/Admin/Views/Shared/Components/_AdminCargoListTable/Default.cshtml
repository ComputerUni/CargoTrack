@model List<ResultCargoDto>
@using CargoTrack.Business.Extensions

@{
    int count = 0;
}


<div class="bg-white rounded-xl border border-outline-variant overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead style="background:#f8f9ff;">
                <tr style="border-bottom:2px solid #e5eeff;">
                    <th class="text-left py-3.5 px-4 font-semibold" style="color:#43474e;">#</th>
                    <th class="text-left py-3.5 px-4 font-semibold" style="color:#43474e;">TAKİP NO</th>
                    <th class="text-left py-3.5 px-4 font-semibold" style="color:#43474e;">GÖNDERICI</th>
                    <th class="text-left py-3.5 px-4 font-semibold" style="color:#43474e;">ALICI</th>
                    <th class="text-left py-3.5 px-4 font-semibold" style="color:#43474e;">ÇIKIŞ → VARIŞ</th>
                    <th class="text-left py-3.5 px-4 font-semibold" style="color:#43474e;">DURUM</th>
                    <th class="text-left py-3.5 px-4 font-semibold" style="color:#43474e;">FİYAT</th>
                    <th class="text-left py-3.5 px-4 font-semibold" style="color:#43474e;">TAHMİNİ TESLİMAT</th>
                    <th class="text-left py-3.5 px-4 font-semibold" style="color:#43474e;">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors">
                            <td class="py-3.5 px-4 font-semibold text-slate-500">@count</td>
                            <td class="py-3.5 px-4 font-mono font-semibold text-on-background text-xs">@item.TrackCode</td>
                            <td class="py-3.5 px-4">@item.SenderName</td>
                            <td class="py-3.5 px-4">@item.ReceiverName</td>
                            <td class="py-3.5 px-4 text-on-surface-variant">@item.OriginBranchName → @item.DestinationBranchName</td>
                            <td class="py-3.5 px-4"><span class="badge" style="background:#e5eeff;color:#001e3c;"><span class="material-symbols-outlined" style="font-size:12px;">local_shipping</span>@item.CargoStatus.GetDisplayName()</span></td>
                            <td class="py-3.5 px-4"><span class="badge" style="background:#e5eeff;color:#001e3c;"><span class="material-symbols-outlined" style="font-size:12px;">local_shipping</span>@item.Price</span></td>
                            <td class="py-3.5 px-4">@item.EstimatedArrivalDate</td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-1">
                                    <button title="Detay" class="p-1.5 rounded-lg hover:bg-surface-container transition-colors"><span class="material-symbols-outlined" style="font-size:18px;color:#486081;">visibility</span></button>
                                    <a asp-area="Admin" asp-controller="Cargo" asp-action="Update" asp-route-id="@item.Id" title="Düzenle" class="p-1.5 rounded-lg hover:bg-surface-container transition-colors block"><span class="material-symbols-outlined" style="font-size:18px;color:#001e3c;">edit</span></a>
                                    <a asp-area="Admin" asp-controller="Cargo" asp-action="Delete" asp-route-id="@item.Id" title="Sil" class="p-1.5 rounded-lg hover:bg-error-container transition-colors"><span class="material-symbols-outlined" style="font-size:18px;color:#ba1a1a;">delete</span></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-6 text-center text-xs text-slate-500">
                            Kayıtlı kargo bulunamadı.
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between px-4 py-4" style="border-top:1px solid #c4c6ce;">
        <span style="color:#43474e;font-size:13px;">1–10 / 847 kayıt gösteriliyor</span>
        <div class="flex items-center gap-1">
            <button class="px-3 py-1.5 rounded-lg text-sm border border-outline-variant" style="color:#43474e;" disabled>← Önceki</button>
            <button class="px-3 py-1.5 rounded-lg text-sm font-bold" style="background:#001e3c;color:#fff;">1</button>
            <button class="px-3 py-1.5 rounded-lg text-sm border border-outline-variant hover:bg-surface-container-low" style="color:#43474e;">2</button>
            <button class="px-3 py-1.5 rounded-lg text-sm border border-outline-variant hover:bg-surface-container-low" style="color:#43474e;">3</button>
            <span class="px-2 text-on-surface-variant">...</span>
            <button class="px-3 py-1.5 rounded-lg text-sm border border-outline-variant hover:bg-surface-container-low" style="color:#43474e;">85</button>
            <button class="px-3 py-1.5 rounded-lg text-sm border border-outline-variant hover:bg-surface-container-low" style="color:#43474e;">Sonraki →</button>
        </div>
    </div>
</div>
