@model List<ResultCargoDto>

@{
    ViewData["Title"] = "Kargolarımız";
    Layout = "~/Areas/Manager/Views/Shared/_ManagerLayout.cshtml";
}

<div>
    <header class="fixed top-0 left-64 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-40 flex items-center justify-between px-margin"><div class="flex items-center gap-space-md"><div class="flex items-center gap-space-xs px-space-sm py-space-xs rounded-lg bg-surface-container-low text-on-surface"><span class="material-symbols-outlined text-[18px] text-primary">store</span><span class="font-label-lg text-label-lg">@ViewBag.Delivery</span></div><div class="hidden md:flex items-center gap-space-xs text-secondary"><span class="material-symbols-outlined text-[16px]">calendar_today</span><span class="font-body-sm text-body-sm">@DateTime.Now.ToString("dd MM yyyy HH:mm")</span></div></div><div class="flex items-center gap-space-md"><button aria-label="Bildirimler" class="relative p-space-xs rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors"><span class="material-symbols-outlined text-[22px]">notifications</span><span class="absolute top-1 right-1 w-4 h-4 bg-error text-on-error rounded-full flex items-center justify-center font-label-sm text-label-sm font-bold leading-none">3</span></button><div class="flex items-center gap-space-sm pl-space-sm"><div class="flex flex-col text-right hidden sm:flex"><span class="font-label-lg text-label-lg text-on-surface">@ViewBag.Manager</span><span class="font-label-sm text-label-sm text-secondary">@ViewBag.Delivery Müdürü</span></div><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shadow-sm"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></div></header><main class="w-full px-margin pt-16 bg-surface min-h-[calc(100vh-32px)]">
    <div class="flex flex-col w-full pb-12">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md py-space-md">
            <div class="flex flex-col gap-1">
                <div class="flex items-center gap-space-xs font-label-md text-label-md text-secondary">
                    <span class="text-on-surface-variant font-medium">Operasyon</span>
                    <span class="text-outline-variant">•</span>
                    <span class="text-primary font-semibold">Dağıtım Listesi</span>
                    <span class="px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-code-dense text-[11px] font-semibold tracking-wide">68 AKTİF GÖREV</span>
                </div>
                <h1 class="font-headline-lg text-headline-lg text-on-surface font-bold tracking-tight">Dağıtım Listesi (Sahadaki Kargolar)</h1>
                <p class="font-body-sm text-body-sm text-secondary">@ViewBag.Delivery bünyesinde bugün dağıtıma çıkarılan (“OutForDelivery”) ve kuryelerde zimmetli kargolar</p>
            </div>
            <div class="flex items-center gap-space-sm flex-wrap">
                <button class="flex items-center gap-space-xs px-space-md py-2 rounded-lg bg-surface-container-lowest text-on-surface shadow-sm hover:bg-surface-container-high transition-colors font-label-lg text-label-lg font-medium" type="button">
                    <span class="material-symbols-outlined text-[18px] text-secondary">print</span>
                    <span>Toplu Dağıtım Fişi Yazdır (PDF)</span>
                </button>
                <button class="flex items-center gap-space-xs px-space-md py-2 rounded-lg bg-primary text-on-primary shadow-sm hover:bg-primary-container transition-colors font-label-lg text-label-lg font-semibold" id="toggleMapBtn" type="button">
                    <span class="material-symbols-outlined text-[18px]">map</span>
                    <span>Haritada Göster</span>
                </button>
            </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter py-space-sm">
            <div class="relative overflow-hidden p-space-md rounded-xl bg-surface-container-lowest shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <div class="flex flex-col">
                        <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Toplam Dağıtımda</span>
                        <div class="flex items-baseline gap-2 mt-1">
                            <span class="font-headline-xl text-headline-xl text-on-surface font-bold font-code-dense">68</span>
                            <span class="font-label-sm text-label-sm text-secondary">Kargo</span>
                        </div>
                    </div>
                    <div class="w-10 h-10 rounded-lg bg-secondary-container text-on-secondary-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">local_shipping</span>
                    </div>
                </div>
                <div class="mt-space-md pt-space-xs flex flex-col gap-1.5">
                    <div class="flex justify-between items-center font-label-sm text-label-sm text-secondary">
                        <span>Dağıtım İlerlemesi</span>
                        <span class="text-primary font-bold">%37 Tamamlandı (26 Teslim)</span>
                    </div>
                    <div class="w-full h-1.5 bg-surface-container-high rounded-full overflow-hidden">
                        <div class="h-full bg-primary rounded-full transition-all duration-500" style="width: 37%"></div>
                    </div>
                </div>
            </div>
            <div class="relative overflow-hidden p-space-md rounded-xl bg-surface-container-lowest shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <div class="flex flex-col">
                        <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Aktif Kurye Sayısı</span>
                        <div class="flex items-baseline gap-2 mt-1">
                            <span class="font-headline-xl text-headline-xl text-on-surface font-bold font-code-dense">4</span>
                            <span class="font-label-sm text-label-sm text-secondary">Kurye Sahada</span>
                        </div>
                    </div>
                    <div class="w-10 h-10 rounded-lg bg-primary-fixed text-on-primary-fixed flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">two_wheeler</span>
                    </div>
                </div>
                <div class="mt-space-md flex items-center gap-space-xs text-primary font-label-sm text-label-sm font-semibold">
                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                    <span>Kadıköy Merkez Ringleri Kesintisiz</span>
                </div>
            </div>
            <div class="relative overflow-hidden p-space-md rounded-xl bg-surface-container-lowest shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <div class="flex flex-col">
                        <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Kalan Teslimat</span>
                        <div class="flex items-baseline gap-2 mt-1">
                            <span class="font-headline-xl text-headline-xl text-on-surface font-bold font-code-dense">42</span>
                            <span class="font-label-sm text-label-sm text-secondary">Paket</span>
                        </div>
                    </div>
                    <div class="w-10 h-10 rounded-lg bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">pending_actions</span>
                    </div>
                </div>
                <div class="mt-space-md flex items-center gap-1 text-secondary font-label-sm text-label-sm">
                    <span class="material-symbols-outlined text-[16px] text-tertiary">schedule</span>
                    <span>Hedef: Bugün 18:00'e kadar</span>
                </div>
            </div>
            <div class="relative overflow-hidden p-space-md rounded-xl bg-surface-container-lowest shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <div class="flex flex-col">
                        <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Ortalama Teslimat Süresi</span>
                        <div class="flex items-baseline gap-1 mt-1">
                            <span class="font-headline-xl text-headline-xl text-on-surface font-bold font-code-dense">22</span>
                            <span class="font-headline-sm text-headline-sm text-on-surface font-semibold">dk</span>
                            <span class="font-label-sm text-label-sm text-secondary">/ paket</span>
                        </div>
                    </div>
                    <div class="w-10 h-10 rounded-lg bg-surface-container-high text-on-surface flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">timer</span>
                    </div>
                </div>
                <div class="mt-space-md flex items-center gap-1 font-label-sm text-label-sm text-primary font-semibold">
                    <span class="material-symbols-outlined text-[16px]">trending_up</span>
                    <span>Önceki vardiyaya kıyasla -4 dk hızlı</span>
                </div>
            </div>
        </div>
        <div class="hidden mb-space-md p-space-md rounded-xl bg-surface-container-lowest shadow-sm" id="mapDrawer">
            <div class="flex items-center justify-between pb-space-sm mb-space-sm">
                <div class="flex items-center gap-space-xs">
                    <span class="material-symbols-outlined text-primary text-[20px]">pin_drop</span>
                    <span class="font-headline-sm text-headline-sm text-on-surface font-semibold">Canlı Saha Kurye &amp; Teslimat Haritası</span>
                    <span class="px-2 py-0.5 rounded-full bg-surface-container text-secondary font-code-dense text-label-sm">Kadıköy 4 Bölge Aktif</span>
                </div>
                <button class="p-1 rounded-lg text-secondary hover:text-on-surface hover:bg-surface-container-high transition-colors" id="closeMapBtn" type="button">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>
            <div class="w-full h-80 rounded-lg overflow-hidden relative shadow-inner" data-location="Kadıköy, Istanbul, Turkey" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDHoub8hQgN8v9AGLX4HQ3a0mI_jXczVCbNy3g0qvdACvS38SNz3SEhQNjvLB4We5aMCvgD7XTVQ_BmhhbhpHlz7qfVGa-shtOYPSiXcyeQB3y3cpafY-cTJiG5XwSaKrtjGfoQ0vAcGCm46KJ7F6jw6YhmwjVrkM1ibRwprgWeIVOo_fGg7qnJ9WTGshV7TugtyanvyL-4g-3FO7OyBfH37BlCxX_o0NYxoKMUTz7KAmDbgoOcL_m-PA')">
                <div class="absolute inset-0 bg-inverse-surface/15 backdrop-blur-[1px]"></div>
                <div class="absolute top-4 left-4 bg-surface-container-lowest/90 backdrop-blur-md p-space-sm rounded-lg shadow-sm flex flex-col gap-1 max-w-xs">
                    <span class="font-label-sm text-label-sm uppercase text-secondary font-bold">Bölge Yoğunlukları</span>
                    <div class="flex items-center justify-between text-body-sm text-body-sm text-on-surface gap-4">
                        <span>Moda &amp; Caferağa</span>
                        <span class="font-code-dense font-bold text-primary">21 Paket</span>
                    </div>
                    <div class="flex items-center justify-between text-body-sm text-body-sm text-on-surface gap-4">
                        <span>Kalamış &amp; Fenerbahçe</span>
                        <span class="font-code-dense font-bold text-primary">14 Paket</span>
                    </div>
                    <div class="flex items-center justify-between text-body-sm text-body-sm text-on-surface gap-4">
                        <span>Göztepe &amp; Feneryolu</span>
                        <span class="font-code-dense font-bold text-primary">18 Paket</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-surface-container-lowest rounded-xl shadow-sm p-space-sm mt-space-md mb-space-sm">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-space-sm items-center">
                <div class="md:col-span-5 relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-secondary text-[20px]">search</span>
                    <input class="w-full h-10 pl-10 pr-space-md rounded-lg bg-surface font-body-md text-body-md text-on-surface placeholder:text-secondary focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary transition-all" id="tableSearch" placeholder="Takip no, alıcı veya sokak adı ile ara..." type="text" />
                </div>
                <div class="md:col-span-3">
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-secondary text-[18px]">person</span>
                        <select class="w-full h-10 pl-10 pr-8 rounded-lg bg-surface font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary appearance-none cursor-pointer" id="courierFilter">
                            <option value="all">Tüm Kuryeler (4 Saha)</option>
                            <option value="Ahmet Yılmaz">Ahmet Yılmaz (Moda)</option>
                            <option value="Berkay Demir">Berkay Demir (Kalamış)</option>
                            <option value="Canan Şahin">Canan Şahin (Göztepe)</option>
                            <option value="Emre Koç">Emre Koç (Koşuyolu)</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>
                <div class="md:col-span-3">
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-secondary text-[18px]">location_on</span>
                        <select class="w-full h-10 pl-10 pr-8 rounded-lg bg-surface font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary appearance-none cursor-pointer" id="districtFilter">
                            <option value="all">Tüm Mahalleler / Bölgeler</option>
                            <option value="Caferağa">Caferağa</option>
                            <option value="Moda">Moda</option>
                            <option value="Feneryolu">Feneryolu</option>
                            <option value="Osmanağa">Osmanağa</option>
                            <option value="Fenerbahçe">Fenerbahçe</option>
                            <option value="Göztepe">Göztepe</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>
                <div class="md:col-span-1 flex justify-end">
                    <button class="w-full h-10 flex items-center justify-center rounded-lg bg-surface text-secondary hover:text-on-surface hover:bg-surface-container-high transition-colors" id="clearFiltersBtn" title="Filtreleri Temizle" type="button">
                        <span class="material-symbols-outlined text-[20px]">filter_alt_off</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md uppercase tracking-wider">
                            <th class="py-3 px-space-md font-semibold">Takip No / Desi</th>
                            <th class="py-3 px-space-md font-semibold">Alıcı &amp; İletişim</th>
                            <th class="py-3 px-space-md font-semibold">Zimmetli Kurye &amp; Araç</th>
                            <th class="py-3 px-space-md font-semibold">Çıkış &amp; Hedef</th>
                            <th class="py-3 px-space-md font-semibold">Teslimat Kodu</th>
                            <th class="py-3 px-space-md font-semibold">Durum</th>
                            <th class="py-3 px-space-md font-semibold text-right">Hızlı Aksiyon</th>
                        </tr>
                    </thead>
                    <tbody class="font-body-md text-body-md text-on-surface" id="packageTableBody">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-surface-container-low/60 transition-colors"
                                data-code="@item.TrackCode"
                                data-receiver="@item.ReceiverName">

                                <td class="py-space-sm px-space-md">
                                    <div class="flex flex-col">
                                        <span class="font-code-dense text-code-dense font-bold text-primary">@item.TrackCode</span>
                                        <span class="font-label-sm text-label-sm text-secondary">@item.Desi Desi • @item.Weight kg</span>
                                    </div>
                                </td>

                                <td class="py-space-sm px-space-md max-w-xs">
                                    <div class="flex flex-col">
                                        <span class="font-semibold text-on-surface">@item.ReceiverName</span>
                                        <span class="font-body-sm text-body-sm text-secondary">@item.DestinationBranchName</span>
                                    </div>
                                </td>

                                <td class="py-space-sm px-space-md">
                                    <span class="font-label-sm text-label-sm text-on-surface-variant">—</span>
                                </td>

                                <td class="py-space-sm px-space-md">
                                    <div class="flex flex-col font-code-dense text-code-dense">
                                        <span class="text-secondary">@item.ShipmentDate.ToString("dd.MM.yyyy")</span>
                                        <span class="font-semibold text-tertiary">Hedef: @item.EstimatedArrivalDate.ToString("dd.MM.yyyy")</span>
                                    </div>
                                </td>

                                <td class="py-space-sm px-space-md">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full font-label-sm text-label-sm bg-secondary-container text-on-secondary-container font-semibold">
                                        <span class="material-symbols-outlined text-[14px]">key</span>
                                        <span>@(item.DeliveryCode ?? "Kod Yok")</span>
                                    </span>
                                </td>

                                <td class="py-space-sm px-space-md">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-label-sm text-label-sm bg-primary-fixed text-on-primary-fixed font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                                        <span>Dağıtıma Çıktı</span>
                                    </span>
                                </td>

                                <td class="py-space-sm px-space-md text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <button class="px-2.5 py-1.5 rounded-lg bg-primary text-on-primary font-label-sm text-label-sm font-semibold hover:bg-primary-container transition-colors shadow-sm"
                                                onclick="openVerifyModal('@item.Id', '@item.TrackCode', '@item.ReceiverName')"
                                                type="button">
                                            Kodu Gir
                                        </button>

                                        <button class="p-1.5 rounded-lg bg-error-container text-on-error-container hover:bg-error hover:text-on-error transition-colors"
                                                onclick="reportIssue('@item.Id', '@item.TrackCode')"
                                                type="button">
                                            <span class="material-symbols-outlined text-[18px]">warning</span>
                                        </button>

                                        <a asp-area="Manager" asp-controller="CargoMovement" asp-action="AddMovement" asp-route-id="@item.Id"
                                           class="p-1.5 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors">
                                            <span class="material-symbols-outlined text-[18px]">alt_route</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-space-sm bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-space-sm font-label-sm text-label-sm text-secondary">
                <div class="flex items-center gap-space-xs">
                    <span>Görüntülenen: <strong class="text-on-surface font-code-dense font-bold" id="visibleCount">5</strong> / 68 kargo</span>
                    <span class="text-outline-variant">•</span>
                    <span>Otomatik yenileme: 30 sn</span>
                </div>
                <div class="flex items-center gap-1 font-code-dense">
                    <button class="px-2 py-1 rounded bg-surface text-secondary hover:text-on-surface" type="button">Önceki</button>
                    <button class="px-2 py-1 rounded bg-primary text-on-primary font-bold" type="button">1</button>
                    <button class="px-2 py-1 rounded bg-surface text-secondary hover:text-on-surface" type="button">2</button>
                    <button class="px-2 py-1 rounded bg-surface text-secondary hover:text-on-surface" type="button">Sonraki</button>
                </div>
            </div>
        </div>
        <div class="fixed inset-0 z-50 bg-inverse-surface/40 backdrop-blur-sm hidden flex items-center justify-center p-space-md" id="verifyModal">
            <div class="w-full max-w-md bg-surface-container-lowest rounded-xl shadow-2xl p-space-lg flex flex-col gap-space-md animate-in fade-in zoom-in-95 duration-150">
                <div class="flex items-center justify-between pb-space-xs">
                    <div class="flex items-center gap-space-xs">
                        <div class="w-8 h-8 rounded-lg bg-primary-fixed text-on-primary-fixed flex items-center justify-center">
                            <span class="material-symbols-outlined text-[20px]">verified_user</span>
                        </div>
                        <span class="font-headline-sm text-headline-sm text-on-surface font-bold">Teslimat Kodu Doğrulama</span>
                    </div>
                    <button class="text-secondary hover:text-on-surface" onclick="closeVerifyModal()" type="button">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>
                <div class="p-space-sm rounded-lg bg-surface-container-low flex flex-col gap-1">
                    <div class="flex justify-between items-center text-body-sm">
                        <span class="text-secondary">Takip Numarası:</span>
                        <span class="font-code-dense font-bold text-primary" id="modalTracking"></span>
                    </div>
                    <div class="flex justify-between items-center text-body-sm">
                        <span class="text-secondary">Alıcı:</span>
                        <span class="font-semibold text-on-surface" id="modalReceiver"></span>
                    </div>
                    <div class="flex justify-between items-center text-body-sm">
                        <span class="text-secondary">Kurye:</span>
                        <span class="text-on-surface-variant font-medium" id="modalCourier"></span>
                    </div>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-md text-label-md text-on-surface font-semibold" for="otpCode">6 Haneli Alıcı Teslimat Kodu (SMS OTP)</label>
                    <div class="flex items-center gap-space-xs">
                        <input class="w-full h-12 text-center text-headline-lg font-code-dense tracking-widest rounded-lg bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary uppercase" id="otpCode" maxlength="6" placeholder="000000" type="text" />
                    </div>
                    <span class="font-label-sm text-label-sm text-secondary">Alıcı telefona SMS olarak gönderilen doğrulama kodu girilmelidir.</span>
                </div>
                <div class="flex items-center justify-end gap-space-xs pt-space-xs">
                    <button class="px-space-md py-2 rounded-lg bg-surface-container-high text-on-surface font-label-lg text-label-lg font-semibold hover:bg-surface-container-highest transition-colors" onclick="closeVerifyModal()" type="button">
                        Vazgeç
                    </button>
                    <button class="px-space-md py-2 rounded-lg bg-primary text-on-primary font-label-lg text-label-lg font-semibold hover:bg-primary-container transition-colors shadow-sm" onclick="submitVerification()" type="button">
                        Teslimatı Onayla
                    </button>
                </div>
            </div>
        </div>
        <div class="fixed inset-0 z-50 bg-inverse-surface/40 backdrop-blur-sm hidden flex items-center justify-center p-space-md" id="issueModal">
            <div class="w-full max-w-md bg-surface-container-lowest rounded-xl shadow-2xl p-space-lg flex flex-col gap-space-md animate-in fade-in zoom-in-95 duration-150">
                <div class="flex items-center justify-between pb-space-xs">
                    <div class="flex items-center gap-space-xs text-error">
                        <span class="material-symbols-outlined text-[22px]">warning</span>
                        <span class="font-headline-sm text-headline-sm text-on-surface font-bold">Sorun / İade Bildirimi</span>
                    </div>
                    <button class="text-secondary hover:text-on-surface" onclick="closeIssueModal()" type="button">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>
                <div class="flex flex-col gap-1">
                    <span class="font-body-sm text-body-sm text-secondary">Kargo No: <strong class="font-code-dense text-on-surface" id="issueTracking"></strong></span>
                    <label class="font-label-md text-label-md text-on-surface font-semibold mt-2" for="issueReason">Sorun Nedeni</label>
                    <select class="h-10 px-space-sm rounded-lg bg-surface font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary appearance-none cursor-pointer" id="issueReason">
                        <option value="adreste_bulunamadi">Adreste Bulunamadı (Kapı Zili / Telefon Cevapsız)</option>
                        <option value="hatali_adres">Hatalı / Eksik Adres Bilgisi</option>
                        <option value="alici_reddi">Alıcı Kargoyu Kabul Etmiyor</option>
                        <option value="hasarli_paket">Hasarlı / Ezik Koli Şüphesi</option>
                        <option value="saat_gecikmesi">Müşteri Saat Aşımı Talebi</option>
                    </select>
                </div>
                <div class="flex flex-col gap-1">
                    <label class="font-label-md text-label-md text-on-surface font-semibold" for="issueNotes">Saha Notu</label>
                    <textarea class="p-space-sm rounded-lg bg-surface font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary resize-none" id="issueNotes" placeholder="Kurye ile yapılan görüşme veya adresteki durumu belirtin..." rows="3"></textarea>
                </div>
                <div class="flex items-center justify-end gap-space-xs pt-space-xs">
                    <button class="px-space-md py-2 rounded-lg bg-surface-container-high text-on-surface font-label-lg text-label-lg font-semibold hover:bg-surface-container-highest transition-colors" onclick="closeIssueModal()" type="button">
                        İptal
                    </button>
                    <button class="px-space-md py-2 rounded-lg bg-error text-on-error font-label-lg text-label-lg font-semibold hover:opacity-90 transition-opacity shadow-sm" onclick="submitIssue()" type="button">
                        Sorun Kaydını Oluştur
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script>
                (function() {
                    const searchInput = document.getElementById('tableSearch');
                    const courierFilter = document.getElementById('courierFilter');
                    const districtFilter = document.getElementById('districtFilter');
                    const clearBtn = document.getElementById('clearFiltersBtn');
                    const tableBody = document.getElementById('packageTableBody');
                    const rows = tableBody ? Array.from(tableBody.querySelectorAll('tr')) : [];
                    const countDisplay = document.getElementById('visibleCount');

                    function filterTable() {
                        const query = (searchInput.value || '').toLowerCase().trim();
                        const courier = courierFilter.value;
                        const district = districtFilter.value;

                        let visible = 0;

                        rows.forEach(row => {
                            const rowCourier = row.getAttribute('data-courier');
                            const rowDistrict = row.getAttribute('data-district');
                            const rowText = row.innerText.toLowerCase();

                            const matchSearch = !query || rowText.includes(query);
                            const matchCourier = courier === 'all' || rowCourier === courier;
                            const matchDistrict = district === 'all' || rowDistrict === district;

                            if (matchSearch && matchCourier && matchDistrict) {
                                row.style.display = '';
                                visible++;
                            } else {
                                row.style.display = 'none';
                            }
                        });

                        if (countDisplay) {
                            countDisplay.textContent = visible;
                        }
                    }

                    if (searchInput) searchInput.addEventListener('input', filterTable);
                    if (courierFilter) courierFilter.addEventListener('change', filterTable);
                    if (districtFilter) districtFilter.addEventListener('change', filterTable);

                    if (clearBtn) {
                        clearBtn.addEventListener('click', () => {
                            if (searchInput) searchInput.value = '';
                            if (courierFilter) courierFilter.value = 'all';
                            if (districtFilter) districtFilter.value = 'all';
                            filterTable();
                        });
                    }

                    const toggleMapBtn = document.getElementById('toggleMapBtn');
                    const closeMapBtn = document.getElementById('closeMapBtn');
                    const mapDrawer = document.getElementById('mapDrawer');

                    if (toggleMapBtn && mapDrawer) {
                        toggleMapBtn.addEventListener('click', () => {
                            mapDrawer.classList.toggle('hidden');
                            if (!mapDrawer.classList.contains('hidden')) {
                                mapDrawer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                            }
                        });
                    }

                    if (closeMapBtn && mapDrawer) {
                        closeMapBtn.addEventListener('click', () => {
                            mapDrawer.classList.add('hidden');
                        });
                    }

                    window.openVerifyModal = function(code, receiver, courier) {
                        document.getElementById('modalTracking').textContent = code;
                        document.getElementById('modalReceiver').textContent = receiver;
                        document.getElementById('modalCourier').textContent = courier;
                        document.getElementById('otpCode').value = '';
                        document.getElementById('verifyModal').classList.remove('hidden');
                        setTimeout(() => document.getElementById('otpCode').focus(), 50);
                    };

                    window.closeVerifyModal = function() {
                        document.getElementById('verifyModal').classList.add('hidden');
                    };

                    window.submitVerification = function() {
                        const code = document.getElementById('otpCode').value.trim();
                        if (!code || code.length < 4) {
                            alert('Lütfen geçerli en az 4 haneli teslim kodunu giriniz.');
                            return;
                        }
                        alert('Kargo teslimatı başarıyla onaylandı ve sistemde kapatıldı: ' + document.getElementById('modalTracking').textContent);
                        window.closeVerifyModal();
                    };

                    window.reportIssue = function(trackingCode) {
                        document.getElementById('issueTracking').textContent = trackingCode;
                        document.getElementById('issueNotes').value = '';
                        document.getElementById('issueModal').classList.remove('hidden');
                    };

                    window.closeIssueModal = function() {
                        document.getElementById('issueModal').classList.add('hidden');
                    };

                    window.submitIssue = function() {
                        const tracking = document.getElementById('issueTracking').textContent;
                        const reason = document.getElementById('issueReason').value;
                        alert('Sorun kaydı oluşturuldu (' + tracking + ') - Şube operasyon havuzuna aktarıldı.');
                        window.closeIssueModal();
                    };

                    window.callCourier = function(name, phone) {
                        const answer = confirm(name + ' ile telefon görüşmesi başlatılsın mı?\nNumara: ' + phone);
                        if (answer) {
                            window.location.href = 'tel:' + phone.replace(/\s+/g, '');
                        }
                    };
                })();
    </script>
</main>
</div>

