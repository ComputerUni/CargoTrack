@using CargoTrack.DTO.DTOs.ManagerDashboardDtos
@model ManagerDashboardKpiDto

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-space-md">
    <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between">
            <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-secondary">Bugün Gelen Kargolar</span>
            <div class="w-7 h-7 rounded-lg bg-surface-container flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[18px]">move_to_inbox</span>
            </div>
        </div>
        <div class="my-space-sm">
            <span class="font-headline-xl text-headline-xl text-on-surface font-bold">@Model.TodayIncoming</span>
        </div>
        <div class="font-body-sm text-body-sm text-on-surface-variant">
            Bugün varış şubesine ulaşan kargolar
        </div>
    </div>

    <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between">
            <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-secondary">Dağıtıma Çıkanlar</span>
            <div class="w-7 h-7 rounded-lg bg-surface-container flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[18px]">local_shipping</span>
            </div>
        </div>
        <div class="my-space-sm">
            <span class="font-headline-xl text-headline-xl text-on-surface font-bold">@Model.OutForDelivery</span>
        </div>
        <div class="font-body-sm text-body-sm text-on-surface-variant">
            Şu an dağıtımda olan kargolar
        </div>
    </div>

    <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between">
            <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-secondary">Bugün Teslim Edilen</span>
            <div class="w-7 h-7 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
            </div>
        </div>
        <div class="my-space-sm">
            <span class="font-headline-xl text-headline-xl text-primary font-bold">@Model.DeliveredToday</span>
        </div>
        <div class="font-body-sm text-body-sm text-primary font-medium">
            Kod ile doğrulanarak teslim edildi
        </div>
    </div>

    <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between">
            <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-secondary">Geciken / Bekleyen</span>
            <div class="w-7 h-7 rounded-lg bg-surface-container-high flex items-center justify-center text-on-surface">
                <span class="material-symbols-outlined text-[18px]">schedule</span>
            </div>
        </div>
        <div class="my-space-sm flex items-baseline gap-space-sm">
            <span class="font-headline-xl text-headline-xl text-on-surface font-bold">@Model.Delayed</span>
            @if (Model.Delayed > 0)
            {
                <span class="px-space-xs py-0.5 rounded-md bg-surface-container text-on-surface font-label-sm text-label-sm font-bold">SLA Riski</span>
            }
        </div>
        <div class="font-body-sm text-body-sm text-on-surface-variant">
            Tahmini teslimat tarihi geçmiş kargolar
        </div>
    </div>

    <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between">
            <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-secondary">Sorunlu &amp; İade</span>
            <div class="w-7 h-7 rounded-lg bg-error-container/40 flex items-center justify-center text-error">
                <span class="material-symbols-outlined text-[18px]">report_problem</span>
            </div>
        </div>
        <div class="my-space-sm flex items-baseline gap-space-sm">
            <span class="font-headline-xl text-headline-xl text-error font-bold">@Model.Problematic</span>
            @if (Model.Problematic > 0)
            {
                <span class="px-space-xs py-0.5 rounded-md bg-error-container text-on-error-container font-label-sm text-label-sm font-bold">Aksiyon</span>
            }
        </div>
        <div class="font-body-sm text-body-sm text-on-surface-variant">
            Teslim edilemeyen ve iade sürecindeki kargolar
        </div>
    </div>
</div>