<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
    <div class="flex items-center gap-space-sm">
        <span class="material-symbols-outlined text-primary text-[20px]">bolt</span>
        <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">Hızlı Erişim</h2>
    </div>
    <div class="grid grid-cols-2 gap-3">
        <a asp-area="Manager" asp-controller="Cargo" asp-action="IncomingList"
           class="rounded-xl bg-surface-container-low flex flex-col items-center justify-center gap-2 hover:bg-surface-container transition-colors text-center" style="height:200px;">
            <span class="material-symbols-outlined text-primary" style="font-size:36px;">move_to_inbox</span>
            <span class="font-label-sm text-label-sm text-secondary font-bold uppercase">Gelen Kargolar</span>
        </a>
        <a asp-area="Manager" asp-controller="Cargo" asp-action="OutgoingList"
           class="rounded-xl bg-surface-container-low flex flex-col items-center justify-center gap-2 hover:bg-surface-container transition-colors text-center" style="height:200px;">
            <span class="material-symbols-outlined text-primary" style="font-size:36px;">outbox</span>
            <span class="font-label-sm text-label-sm text-secondary font-bold uppercase">Giden Kargolar</span>
        </a>
        <a asp-area="Manager" asp-controller="Cargo" asp-action="Index"
           class="rounded-xl bg-surface-container-low flex flex-col items-center justify-center gap-2 hover:bg-surface-container transition-colors text-center" style="height:200px;">
            <span class="material-symbols-outlined text-primary" style="font-size:36px;">local_shipping</span>
            <span class="font-label-sm text-label-sm text-secondary font-bold uppercase">Şube Kargoları</span>
        </a>
        <a asp-area="Manager" asp-controller="Delivery" asp-action="DeliveryFailedAndReturnInProcessList"
           class="rounded-xl bg-surface-container-low flex flex-col items-center justify-center gap-2 hover:bg-surface-container transition-colors text-center" style="height:200px;">
            <span class="material-symbols-outlined text-error" style="font-size:36px;">report_problem</span>
            <span class="font-label-sm text-label-sm text-secondary font-bold uppercase">Sorunlu Kargolar</span>
        </a>
    </div>
</div>