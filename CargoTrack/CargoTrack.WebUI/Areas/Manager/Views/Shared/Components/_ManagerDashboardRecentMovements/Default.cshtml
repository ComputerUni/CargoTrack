@using CargoTrack.DTO.DTOs.CargoMovementDtos
@model List<ResultCargoMovementDto>

<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
    <div class="flex items-center justify-between pb-space-xs">
        <div class="flex items-center gap-space-sm">
            <span class="material-symbols-outlined text-primary text-[20px]">history</span>
            <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">Son Kargo Hareketleri (Canlı Şube Akışı)</h2>
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low text-secondary font-label-sm text-label-sm uppercase tracking-wider">
                    <th class="py-space-sm px-space-md rounded-l-lg">Takip No</th>
                    <th class="py-space-sm px-space-md">Gönderici / Alıcı</th>
                    <th class="py-space-sm px-space-md">İşlem Tipi</th>
                    <th class="py-space-sm px-space-md">Durum</th>
                    <th class="py-space-sm px-space-md">Saat</th>
                    <th class="py-space-sm px-space-md rounded-r-lg">İşlemi Yapan</th>
                </tr>
            </thead>
            <tbody class="divide-y-0">
                @foreach(var item in Model)
                {
                    <tr class="hover:bg-surface-container-low/70 transition-colors">
                        <td class="py-space-md px-space-md font-code-dense text-code-dense font-semibold text-primary">@item.TrackCode</td>
                        <td class="py-space-md px-space-md">
                            <div class="font-label-lg text-label-lg text-on-surface font-semibold">@item.SenderName</div>
                            <div class="font-body-sm text-body-sm text-secondary">@item.ReceiverName</div>
                        </td>
                        <td class="py-space-md px-space-md font-body-sm text-body-sm text-on-surface">@item.Description</td>
                        <td class="py-space-md px-space-md">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-label-sm text-label-sm font-semibold bg-primary/10 text-primary">@item.NewStatus.GetDisplayName()</span>
                        </td>
                        <td class="py-space-md px-space-md font-code-dense text-code-dense text-secondary">@item.CreatedDate</td>
                        <td class="py-space-md px-space-md font-body-sm text-body-sm text-on-surface">Kurye: @item.EmployeeName</td>
                    </tr>
                }
                
            </tbody>
        </table>
    </div>
</div>
