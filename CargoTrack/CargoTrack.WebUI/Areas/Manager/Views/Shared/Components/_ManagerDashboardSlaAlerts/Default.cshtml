@using CargoTrack.DTO.DTOs.CargoMovementDtos
@using CargoTrack.Entity.Entities.Enums
@model List<ResultCargoMovementDto>

<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md h-full">
    <div class="flex items-center justify-between pb-space-xs">
        <div class="flex items-center gap-space-sm">
            <span class="material-symbols-outlined text-error text-[20px]">notification_important</span>
            <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">Kritik Uyarılar &amp; SLA</h2>
        </div>
        <span class="w-2 h-2 rounded-full bg-error animate-ping"></span>
    </div>
    <div class="flex flex-col gap-space-sm">
        @if (!Model.Any())
        {
            <div class="p-space-md rounded-xl bg-surface-container-low flex items-center gap-space-sm">
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">check_circle</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">Sorunlu kargo bulunmuyor.</span>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                var (icon, label, color) = item.NewStatus switch
                {
                    CargoStatus.DeliveryFailed =>
                        ("cancel", "Teslim Edilemedi", "text-error"),
                    CargoStatus.ReturnInProcess =>
                        ("assignment_return", "İade Sürecinde", "text-warning"),
                    CargoStatus.ReturnedToSender =>
                        ("undo", "Göndericiye İade Edildi", "text-on-surface-variant"),
                    _ => ("timer", "Sorunlu Kargo", "text-error")
                };

                <div class="p-space-md rounded-xl bg-surface-container-low flex items-start gap-space-sm">
                    <span class="material-symbols-outlined text-[18px] @color shrink-0 mt-0.5">@icon</span>
                    <div class="flex flex-col gap-0.5">
                        <span class="font-label-md text-label-md font-bold text-on-surface">@label</span>
                        <p class="font-body-sm text-body-sm text-on-surface-variant leading-tight">
                            <strong class="font-code-dense text-code-dense text-on-surface">@item.TrackCode</strong>
                            — @item.MovementDate.ToString("dd MMM, HH:mm")
                        </p>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="font-body-sm text-body-sm text-on-surface-variant leading-tight">@item.Description</p>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>