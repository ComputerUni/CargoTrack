<aside class="fixed left-0 top-0 h-full w-64 bg-surface-container-low shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-50 flex flex-col justify-between">
    <div class="flex flex-col">
        <div class="p-space-lg flex items-center justify-between">
            <div class="flex items-center gap-space-sm">
                <div class="w-9 h-9 rounded-xl bg-primary flex items-center justify-center text-on-primary shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
                    <span class="material-symbols-outlined text-[20px]">local_shipping</span>
                </div><div>
                <span class="font-headline-sm text-headline-sm font-bold text-on-surface tracking-tight block leading-none">CargoTrack</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Lojistik Ağı</span>
            </div>
        </div><span class="bg-primary-container text-on-primary-container font-label-sm text-label-sm px-space-sm py-space-xs rounded-full font-bold">Şube</span>
    </div>
    <div class="px-space-md mb-space-sm">
        <div class="bg-surface-container px-space-md py-space-sm rounded-xl flex items-center justify-between shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
            <div class="flex items-center gap-space-sm overflow-hidden">
                <span class="w-2 h-2 rounded-full bg-primary-fixed-dim animate-pulse shrink-0"></span><div class="truncate">
                <div class="font-label-lg text-label-lg text-on-surface truncate">@ViewBag.OriginalName</div>
            </div>
        </div>
    </div>
</div>
<nav class="px-space-md flex flex-col gap-space-xs overflow-y-auto max-h-[calc(100vh-250px)]" data-active-classes="bg-primary-container text-on-primary-container font-bold rounded-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="pt-space-sm pb-space-xs px-space-sm font-label-sm text-label-sm text-on-surface-variant font-bold uppercase tracking-wider">Genel</div>
    <a class="flex items-center gap-space-md px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all" data-path="dashboard" href="#"><span class="material-symbols-outlined text-[18px]">grid_view</span><span>Dashboard</span></a>
    <div class="pt-space-md pb-space-xs px-space-sm font-label-sm text-label-sm text-on-surface-variant font-bold uppercase tracking-wider">Operasyon &amp; Kargo</div>
    <a class="flex items-center gap-space-md px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all" data-path="sube-kargolari" href="/Manager/Cargo/Index/"><span class="material-symbols-outlined text-[18px]">inventory_2</span><span>Şube Kargoları</span></a>
    <a class="flex items-center gap-space-md px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all"
       href="/Manager/Cargo/IncomingList">
        <span class="material-symbols-outlined text-[18px]">move_to_inbox</span>
        <span>Gelen Kargolar</span>
    </a>

    <a class="flex items-center gap-space-md px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all"
       href="/Manager/Cargo/OutgoingList">
        <span class="material-symbols-outlined text-[18px]">local_shipping</span>
        <span>Giden Kargolar</span>
    </a>
    <a class="flex items-center gap-space-md px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all" data-path="dagitim-listesi-ve-kuryeler" href="/Manager/Delivery/DeliveryList"><span class="material-symbols-outlined text-[18px]">local_shipping</span><span>Dağıtım Listesi &amp; Kuryeler</span></a>
    <a class="flex items-center gap-space-md px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all" data-path="sorunlu-kargo-ve-iade" href="/Manager/Delivery/DeliveryFailedAndReturnInProcessList"><span class="material-symbols-outlined text-[18px]">warning</span><span>Sorunlu Kargo &amp; İade</span></a>
    <div class="pt-space-md pb-space-xs px-space-sm font-label-sm text-label-sm text-on-surface-variant font-bold uppercase tracking-wider">Yönetim &amp; Raporlar</div>
    <a class="flex items-center gap-space-md px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all" data-path="sube-personeli" href="#"><span class="material-symbols-outlined text-[18px]">group</span><span>Şube Personeli</span></a>
    <a class="flex items-center gap-space-md px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all" data-path="gunluk-islem-ozeti" href="#"><span class="material-symbols-outlined text-[18px]">query_stats</span><span>Günlük İşlem Özeti</span></a>
</nav>
</div>
<div class="p-space-md bg-surface-container-low shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="bg-surface-container-lowest p-space-sm rounded-xl flex items-center justify-between shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
        <div class="flex items-center gap-space-sm">
            <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-on-primary font-headline-sm text-headline-sm font-bold">@ViewBag.Manager.Substring(0,1)</div>
            <div class="overflow-hidden">
                <div class="font-label-md text-label-md text-on-surface font-bold truncate">@ViewBag.Manager</div><div class="font-label-sm text-label-sm text-on-surface-variant truncate">@ViewBag.OriginalName</div>
            </div>
        </div>
        <form asp-area-route="" asp-action="Logout" asp-controller="Login">
            <button class="w-8 h-8 rounded-xl flex items-center justify-center text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all shrink-0" title="Çıkış Yap" type="button"><span class="material-symbols-outlined text-[18px]">logout</span></button>
        </form>
    </div>
</div>
</aside>
