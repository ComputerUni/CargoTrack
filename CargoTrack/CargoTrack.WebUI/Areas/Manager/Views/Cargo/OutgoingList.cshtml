@using CargoTrack.Entity.Entities.Enums
@using X.PagedList.Mvc.Core
@model CargoIndexViewModel

@{
    ViewData["Title"] = "Kargolarımız";
    Layout = "~/Areas/Manager/Views/Shared/_ManagerLayout.cshtml";
    int count = 0;
}


<div class="flex flex-col w-full pb-space-xl">
    <!-- Operational Breadcrumb & Live Sync Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md py-space-md">
        <div class="flex flex-col">
            <div class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant">
                <span class="hover:text-primary cursor-pointer transition-colors">Operasyon</span>
                <span class="material-symbols-outlined text-[13px] text-outline-variant">chevron_right</span>
                <span class="text-on-surface font-semibold">Şubeden Giden Kargolar</span>
                <span class="ml-space-sm inline-flex items-center gap-1 bg-surface-container-high px-space-xs py-0.5 rounded-full font-code-dense text-code-dense text-on-surface"></span>
            </div>
            <div class="flex items-baseline gap-space-sm mt-space-xs">
                <h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">Şubeden Giden Kargolar</h1>
                <span class="font-code-dense text-code-dense px-space-sm py-0.5 rounded-full bg-surface-container text-on-surface-variant">@ViewBag.OutgoingName</span>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">
                @ViewBag.OutgoingName'ne bağlı gelen, çıkan, dağıtımdaki ve devir kargoların anlık manifestosu
            </p>
        </div>
    </div>
    <!-- Operational Metric Quick Strip (4 compact cards) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter mb-space-lg">
        <!-- Metric 1: Total Cargo -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex items-center justify-between">
            <div class="flex flex-col">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Toplam Giden Kargo</span>
                <div class="flex items-baseline gap-space-xs mt-1">
                    <span class="font-headline-xl text-headline-xl text-on-surface font-bold">@Model.Outgoing.TotalOutgoing</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[24px]">inventory_2</span>
            </div>
        </div>
        <!-- Metric 2: Out for Delivery -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex items-center justify-between">
            <div class="flex flex-col">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Transfer Merkezinde</span>
                <div class="flex items-baseline gap-space-xs mt-1">
                    <span class="font-headline-xl text-headline-xl text-on-surface font-bold">@Model.Outgoing.InTransferCenter</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-secondary">
                <span class="material-symbols-outlined text-[24px]">two_wheeler</span>
            </div>
        </div>
        <!-- Metric 3: Waiting on Shelf -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex items-center justify-between">
            <div class="flex flex-col">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Göndericiye İade Edilen</span>
                <div class="flex items-baseline gap-space-xs mt-1">
                    <span class="font-headline-xl text-headline-xl text-on-surface font-bold">@Model.Outgoing.ReturnedToSender</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-on-surface-variant">
                <span class="material-symbols-outlined text-[24px]">shelves</span>
            </div>
        </div>
        <!-- Metric 4: Outbound Transfers -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex items-center justify-between">
            <div class="flex flex-col">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Dağıtıma Çıkan</span>
                <div class="flex items-baseline gap-space-xs mt-1">
                    <span class="font-headline-xl text-headline-xl text-on-surface font-bold">@Model.Outgoing.OutOfDelivery</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-primary-container">
                <span class="material-symbols-outlined text-[24px] text-on-primary-container">local_shipping</span>
            </div>
        </div>
    </div>
    <!-- Operational Search & Multi-Filter Control Console -->
    <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm mb-space-md">
        <!-- Top Search Row -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center gap-space-sm mb-space-md">
            <div class="relative flex-1">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[20px] text-outline">search</span>
                <input class="w-full pl-10 pr-10 py-2 bg-surface-container-low text-on-surface placeholder:text-outline rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary transition-all" id="cargo-search-input" placeholder="Kargo Takip No (MYC-...), Alıcı/Gönderici Adı veya Telefon..." type="text" />
                <button class="absolute right-2.5 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" title="Barkod Okuyucu Başlat" type="button">
                    <span class="material-symbols-outlined text-[20px]">qr_code_scanner</span>
                </button>
            </div>
            <div class="flex items-center gap-space-xs shrink-0">
                <button class="inline-flex items-center gap-space-xs bg-inverse-surface text-inverse-on-surface hover:bg-on-surface px-space-lg py-2 rounded-lg font-label-lg text-label-lg shadow-sm transition-all" type="button">
                    <span class="material-symbols-outlined text-[17px]">filter_alt</span>
                    <span>Filtrele</span>
                </button>
                <button class="inline-flex items-center gap-space-xs text-on-surface-variant hover:text-error px-space-md py-2 rounded-lg font-label-lg text-label-lg transition-colors" type="button">
                    <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                    <span>Temizle</span>
                </button>
            </div>
        </div>
        <!-- Filter Multi-Select Fields Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-sm">
            <!-- Filter: Direction -->
            <div class="flex flex-col gap-1">
                <label class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-bold">Kargo Yönü</label>
                <div class="relative">
                    <select class="w-full bg-surface-container-low text-on-surface font-body-sm text-body-sm py-2 px-3 pr-8 rounded-lg appearance-none focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary cursor-pointer">
                        <option selected="">Tümü (Gelen &amp; Giden)</option>
                        <option>Şubeye Gelen (Varış)</option>
                        <option>Şubeden Çıkan (Gönderici)</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-[18px] text-outline pointer-events-none">expand_more</span>
                </div>
            </div>
            <!-- Filter: Operational Status -->
            <div class="flex flex-col gap-1">
                <label class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-bold">Operasyonel Durum</label>
                <div class="relative">
                    <select class="w-full bg-surface-container-low text-on-surface font-body-sm text-body-sm py-2 px-3 pr-8 rounded-lg appearance-none focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary cursor-pointer">
                        <option selected="">Tüm Durumlar (184)</option>
                        <option>Varış Şubesinde (44)</option>
                        <option>Dağıtıma Çıktı (68)</option>
                        <option>Teslim Edildi (52)</option>
                        <option>Sorunlu / Teslim Edilemedi (12)</option>
                        <option>İade Sürecinde (8)</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-[18px] text-outline pointer-events-none">expand_more</span>
                </div>
            </div>
            <!-- Filter: Assigned Courier -->
            <div class="flex flex-col gap-1">
                <label class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-bold">Atanan Kurye</label>
                <div class="relative">
                    <select class="w-full bg-surface-container-low text-on-surface font-body-sm text-body-sm py-2 px-3 pr-8 rounded-lg appearance-none focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary cursor-pointer">
                        <option selected="">Tüm Kuryeler &amp; Hatlar</option>
                        <option>Ahmet Yılmaz (Moda Sahası)</option>
                        <option>Berkay Demir (Kalamış Sahası)</option>
                        <option>Canan Şahin (Göztepe Sahası)</option>
                        <option>Emre Koç (Koşuyolu Sahası)</option>
                        <option class="text-error font-semibold">⚠️ Atama Bekleyenler (12)</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-[18px] text-outline pointer-events-none">expand_more</span>
                </div>
            </div>
            <!-- Filter: Desi / Type -->
            <div class="flex flex-col gap-1">
                <label class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-bold">Desi / Kargo Tipi</label>
                <div class="relative">
                    <select class="w-full bg-surface-container-low text-on-surface font-body-sm text-body-sm py-2 px-3 pr-8 rounded-lg appearance-none focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary cursor-pointer">
                        <option selected="">Tümü (Desi &amp; Paket)</option>
                        <option>Dosya / Evrak (1-2 Desi)</option>
                        <option>Koli (3-15 Desi)</option>
                        <option>Ağır Kargo (15+ Desi)</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-[18px] text-outline pointer-events-none">expand_more</span>
                </div>
            </div>
        </div>
    </div>
    <!-- Main Cargo Operational Data Table -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden mb-space-md">
        <!-- Active Table Action & Status Toolbar -->
        <div class="bg-surface-container-low px-space-md py-space-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-sm">
            <div class="flex items-center gap-space-md">
                <div class="flex items-center gap-space-xs font-label-lg text-label-lg text-on-surface">
                    <span class="material-symbols-outlined text-[18px] text-primary">view_list</span>
                    <span>Aktif Liste: <strong>@ViewBag.OutgoingName Dağıtım &amp; Kabul Çizelgesi</strong></span>
                </div>
            </div>
        </div>
        <!-- Table Container -->
        <div class="w-full overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md uppercase tracking-wider select-none">
                        <th class="w-10 px-space-md py-3 text-center">
                            <input class="rounded accent-primary w-4 h-4 cursor-pointer" id="check-all-cargo" type="checkbox" />
                        </th>
                        <th class="w-12 px-space-xs py-3 text-center">#</th>
                        <th class="px-space-md py-3 font-semibold">Takip No</th>
                        <th class="px-space-md py-3 font-semibold">Gönderici Bilgisi</th>
                        <th class="px-space-md py-3 font-semibold">Alıcı & Teslimat Adresi</th>
                        <th class="px-space-sm py-3 font-semibold text-center">Desi / Tip</th>
                        <th class="px-space-md py-3 font-semibold">Güncel Durum</th>
                        <th class="px-space-md py-3 font-semibold">Kargo Tipi</th>
                        <th class="px-space-md py-3 font-semibold">Tahmini Teslimat</th>
                        <th class="px-space-md py-3 text-right font-semibold">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container font-body-md text-body-md text-on-surface">
                    @foreach (var cargo in Model.Cargos)
                    {
                        count++;

                        <tr class="hover:bg-surface-container-low/60 transition-colors group">

                            <td class="px-space-md py-3 text-center">
                                <input class="row-checkbox rounded accent-primary w-4 h-4 cursor-pointer" type="checkbox" />
                            </td>

                            <td class="px-space-xs py-3 text-center font-code-dense text-code-dense text-outline">
                                @count
                            </td>

                            <td class="px-space-md py-3">
                                <span class="font-code-dense text-code-dense font-bold text-on-surface group-hover:text-primary transition-colors cursor-pointer">
                                    @cargo.TrackCode
                                </span>
                                <div class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">
                                    @cargo.ShipmentDate.ToString("dd MMM yyyy")
                                </div>
                            </td>

                            <td class="px-space-md py-3">
                                <div class="font-label-lg text-label-lg font-semibold text-on-surface">@cargo.SenderName</div>
                                <div class="font-body-sm text-body-sm text-on-surface-variant">@cargo.OriginBranchName</div>
                            </td>

                            <td class="px-space-md py-3">
                                <div class="font-label-lg text-label-lg font-semibold text-on-surface">@cargo.ReceiverName</div>
                                <div class="font-body-sm text-body-sm text-on-surface-variant">@cargo.DestinationBranchName</div>
                            </td>

                            <td class="px-space-sm py-3 text-center">
                                <span class="inline-block px-2 py-0.5 rounded-full bg-surface-container font-code-dense text-code-dense font-semibold text-on-surface">
                                    @cargo.Desi.ToString("N2") Desi
                                </span>
                                <span class="block font-label-sm text-label-sm text-on-surface-variant mt-0.5">
                                    @cargo.Weight kg
                                </span>
                            </td>

                            <td class="px-space-md py-3">
                                @{
                                    var (bgClass, textClass, label) = cargo.CargoStatus switch
                                    {
                                        CargoStatus.Created => ("bg-surface-container-high", "text-on-surface-variant", "Oluşturuldu"),
                                        CargoStatus.AtOriginBranch => ("bg-surface-container-highest", "text-on-surface", "Gönderici Şubesinde"),
                                        CargoStatus.InTransferCenter => ("bg-secondary-container", "text-on-secondary-container", "Transfer Merkezinde"),
                                        CargoStatus.ArrivedAtDeliveryBranch => ("bg-surface-container-highest", "text-on-surface", "Varış Şubesinde"),
                                        CargoStatus.OutForDelivery => ("bg-secondary-container", "text-on-secondary-container", "Dağıtıma Çıktı"),
                                        CargoStatus.Delivered => ("bg-primary-container", "text-on-primary-container", "Teslim Edildi"),
                                        CargoStatus.DeliveryFailed => ("bg-error-container", "text-on-error-container", "Teslim Edilemedi"),
                                        CargoStatus.ReturnInProcess => ("bg-error-container", "text-error", "İade Sürecinde"),
                                        CargoStatus.ReturnedToSender => ("bg-surface-container", "text-on-surface-variant", "Göndericiye İade"),
                                        _ => ("bg-surface-container", "text-on-surface-variant", cargo.CargoStatus.ToString())
                                    };
                                }
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-md text-label-md font-semibold @bgClass @textClass">
                                    @label
                                </span>
                                @if (cargo.FailedAttemptCount > 0)
                                {
                                    <span class="block font-label-sm text-label-sm text-error mt-0.5">
                                        @cargo.FailedAttemptCount. Deneme
                                    </span>
                                }
                            </td>

                            <td class="px-space-md py-3">
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-surface-container font-label-sm text-label-sm text-on-surface-variant font-semibold">
                                    @cargo.CargoType
                                </span>
                            </td>

                            <td class="px-space-md py-3">
                                @if (cargo.EstimatedArrivalDate < DateTime.Now && cargo.CargoStatus != CargoStatus.Delivered && cargo.CargoStatus != CargoStatus.ReturnedToSender)
                                {
                                    <span class="text-error text-xs font-bold flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[14px]">warning</span>
                                        Gecikmiş
                                    </span>
                                }
                                else
                                {
                                    <div class="font-code-dense text-code-dense font-semibold text-on-surface">
                                        @cargo.EstimatedArrivalDate.ToString("dd MMM yyyy")
                                    </div>
                                }
                                <div class="font-body-sm text-body-sm text-on-surface-variant">
                                    @cargo.Price.ToString("C2")
                                </div>
                            </td>

                            <td class="px-space-md py-3 text-right">
                                <div class="flex items-center justify-end gap-1">
                                    @if (cargo.CargoStatus == CargoStatus.Created || cargo.CargoStatus == CargoStatus.AtOriginBranch || cargo.CargoStatus == CargoStatus.InTransferCenter)
                                    {
                                        <a asp-area="Manager" asp-controller="CargoMovement" asp-action="AddMovement" asp-route-id="@cargo.Id"
                                           class="w-8 h-8 rounded-lg flex items-center justify-center text-primary hover:bg-surface-container transition-colors"
                                           title="Hareket Ekle">
                                            <span class="material-symbols-outlined text-[18px]">add_location_alt</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" disabled
                                                class="w-8 h-8 rounded-lg flex items-center justify-center text-outline/40 cursor-not-allowed opacity-60"
                                                title="Kargo varış şubesinde, işlem yapılamaz">
                                            <span class="material-symbols-outlined text-[18px]">lock</span>
                                        </button>
                                    }

                                    <a asp-area="Manager" asp-controller="Cargo" asp-action="CargoDetail" asp-route-id="@cargo.Id"
                                       class="w-8 h-8 rounded-lg flex items-center justify-center text-outline hover:bg-surface-container hover:text-on-surface transition-colors"
                                       title="Detay">
                                        <span class="material-symbols-outlined text-[18px]">info</span>
                                    </a>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
            <div class="mt-4">
                @Html.PagedListPager(Model.Cargos, page => Url.Action("Index", new { page }), new PagedListRenderOptions
                {
                    UlElementClasses = new[] { "flex items-center gap-1 justify-right p-3" },
                    LiElementClasses = new[] { "inline-flex" },
                    PageClasses = new[] { "w-9 h-9 flex items-center justify-center rounded-xl border border-outline-variant text-sm font-semibold text-on-surface hover:bg-surface-container transition-colors" },
                    PreviousElementClass = "w-9 h-9 flex items-center justify-center rounded-xl border border-outline-variant text-on-surface hover:bg-surface-container transition-colors",
                    NextElementClass = "w-9 h-9 flex items-center justify-center rounded-xl border border-outline-variant text-on-surface hover:bg-surface-container transition-colors",
                    DisplayLinkToFirstPage = PagedListDisplayMode.Never,
                    DisplayLinkToLastPage = PagedListDisplayMode.Never,
                    LinkToPreviousPageFormat = "←",
                    LinkToNextPageFormat = "→"
                })
            </div>
        </div>
    </div>
    <script>
            (function() {
                // Checkbox master toggle
                const checkAll = document.getElementById('check-all-cargo');
                const rowBoxes = document.querySelectorAll('.row-checkbox');
                const bulkBar = document.getElementById('bulk-action-bar');

                if (checkAll) {
                    checkAll.addEventListener('change', function() {
                        rowBoxes.forEach(function(box) {
                            box.checked = checkAll.checked;
                        });
                        updateBulkState();
                    });
                }

                rowBoxes.forEach(function(box) {
                    box.addEventListener('change', function() {
                        updateBulkState();
                    });
                });

                function updateBulkState() {
                    const checkedCount = Array.from(rowBoxes).filter(b => b.checked).length;
                    if (bulkBar) {
                        if (checkedCount > 0) {
                            bulkBar.classList.remove('opacity-90');
                            bulkBar.classList.add('opacity-100', 'ring-1', 'ring-primary', 'bg-surface-container-high', 'p-1', 'rounded-lg');
                        } else {
                            bulkBar.classList.remove('opacity-100', 'ring-1', 'ring-primary', 'bg-surface-container-high', 'p-1');
                            bulkBar.classList.add('opacity-90');
                        }
                    }
                }
            })();
    </script>
</div>

