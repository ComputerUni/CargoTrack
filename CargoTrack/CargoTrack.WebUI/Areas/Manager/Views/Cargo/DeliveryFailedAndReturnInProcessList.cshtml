@using CargoTrack.Entity.Entities.Enums
@model List<ResultCargoDto>

@{
    ViewData["Title"] = "Kargolarımız";
    Layout = "~/Areas/Manager/Views/Shared/_ManagerLayout.cshtml";
    int count = 0;
}

<div class="pl-64">
    <header class="fixed top-0 left-64 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-40 flex items-center justify-between px-margin"><div class="flex items-center gap-space-md"><div class="flex items-center gap-space-xs px-space-sm py-space-xs rounded-lg bg-surface-container-low text-on-surface"><span class="material-symbols-outlined text-[18px] text-primary">store</span><span class="font-label-lg text-label-lg">Kadıköy Depo Şube</span><span class="font-code-dense text-code-dense text-secondary bg-surface-container-high px-space-xs py-0.5 rounded">BR-3401</span><span class="material-symbols-outlined text-[18px] text-secondary">arrow_drop_down</span></div><div class="hidden md:flex items-center gap-space-xs text-secondary"><span class="material-symbols-outlined text-[16px]">calendar_today</span><span class="font-body-sm text-body-sm">24 Ekim 2024, Perşembe</span></div></div><div class="flex items-center gap-space-md"><button aria-label="Bildirimler" class="relative p-space-xs rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors"><span class="material-symbols-outlined text-[22px]">notifications</span><span class="absolute top-1 right-1 w-4 h-4 bg-error text-on-error rounded-full flex items-center justify-center font-label-sm text-label-sm font-bold leading-none">3</span></button><div class="flex items-center gap-space-sm pl-space-sm"><div class="flex flex-col text-right hidden sm:flex"><span class="font-label-lg text-label-lg text-on-surface">Murat Özdemir</span><span class="font-label-sm text-label-sm text-secondary">Şube Müdürü</span></div><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shadow-sm"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></div></header><main class="w-full px-margin pt-16 bg-surface min-h-[calc(100vh-32px)]">
    <div class="flex flex-col w-full pb-12">
        <!-- Top Operational Banner & Critical Notice -->
        <div class="mb-6 rounded-xl bg-surface-container-lowest p-space-lg shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
            <div class="flex items-start gap-space-md">
                <div class="w-12 h-12 rounded-xl bg-error-container text-on-error-container flex items-center justify-center flex-shrink-0 shadow-sm">
                    <span class="material-symbols-outlined text-[28px]" style="font-variation-settings: 'FILL' 1;">report_problem</span>
                </div>
                <div class="flex flex-col">
                    <div class="flex items-center gap-space-xs flex-wrap">
                        <span class="font-headline-lg text-headline-lg text-on-surface">Sorunlu Kargolar &amp; Başarısız Teslimatlar</span>
                        <span class="px-space-xs py-0.5 rounded-full font-label-sm text-label-sm bg-error-container text-on-error-container uppercase tracking-wider">İstisnalar Masası</span>
                    </div>
                    <p class="font-body-md text-body-md text-secondary mt-1">
                        Teslim edilemeyen (DeliveryFailed), adreste bulunamayan ve iade sürecindeki şube kargoları
                    </p>
                </div>
            </div>
            <!-- Right Header Actions -->
            <div class="flex items-center gap-space-sm flex-wrap self-end lg:self-center">
                <button class="flex items-center gap-space-xs px-space-md py-space-xs rounded-lg bg-surface-container-high text-on-surface font-label-lg text-label-lg hover:bg-surface-container-highest transition-colors shadow-sm" onclick="downloadReportModal()">
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    <span>Sorun Raporu İndir (Excel)</span>
                </button>
                <button class="flex items-center gap-space-xs px-space-md py-space-xs rounded-lg bg-error text-on-error font-label-lg text-label-lg hover:opacity-90 transition-opacity shadow-sm" onclick="openBatchReturnModal()">
                    <span class="material-symbols-outlined text-[18px]">assignment_return</span>
                    <span>Toplu İade Başlat</span>
                </button>
            </div>
        </div>
        <!-- Status / KPI Summary Cards (Bento Metric Strip) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md mb-6">
            <!-- Card 1: Total Failed -->
            <div class="rounded-xl bg-surface-container-lowest p-space-md shadow-sm relative overflow-hidden flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <span class="font-label-md text-label-md uppercase text-secondary tracking-wider">Toplam Sorunlu / Askıda</span>
                    <span class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-secondary">
                        <span class="material-symbols-outlined text-[18px]">inventory_2</span>
                    </span>
                </div>
                <div class="mt-3 flex items-baseline gap-space-xs">
                    <span class="font-headline-xl text-headline-xl text-on-surface">12</span>
                    <span class="font-body-sm text-body-sm text-secondary">kargo bekliyor</span>
                </div>
                <div class="mt-2 flex items-center gap-1 font-label-sm text-label-sm text-secondary">
                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                    <span>Kadıköy BR-3401 Güncel Vardiyası</span>
                </div>
            </div>
            <!-- Card 2: 1st Attempt -->
            <div class="rounded-xl bg-surface-container-lowest p-space-md shadow-sm relative overflow-hidden flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <span class="font-label-md text-label-md uppercase text-secondary tracking-wider">1. Deneme Başarısız</span>
                    <span class="w-8 h-8 rounded-lg bg-surface-container-low flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[18px]">replay</span>
                    </span>
                </div>
                <div class="mt-3 flex items-baseline gap-space-xs">
                    <span class="font-headline-xl text-headline-xl text-primary">7</span>
                    <span class="font-body-sm text-body-sm text-secondary">kargo</span>
                </div>
                <div class="mt-2 flex items-center gap-1 font-label-sm text-label-sm text-primary">
                    <span class="material-symbols-outlined text-[14px]">check_circle</span>
                    <span>Yeniden dağıtıma uygun</span>
                </div>
            </div>
            <!-- Card 3: 2nd Attempt -->
            <div class="rounded-xl bg-surface-container-lowest p-space-md shadow-sm relative overflow-hidden flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <span class="font-label-md text-label-md uppercase text-secondary tracking-wider">2. Deneme Başarısız</span>
                    <span class="w-8 h-8 rounded-lg bg-secondary-container flex items-center justify-center text-on-secondary-container">
                        <span class="material-symbols-outlined text-[18px]">notification_important</span>
                    </span>
                </div>
                <div class="mt-3 flex items-baseline gap-space-xs">
                    <span class="font-headline-xl text-headline-xl text-on-surface">3</span>
                    <span class="font-body-sm text-body-sm text-secondary">kargo</span>
                </div>
                <div class="mt-2 flex items-center gap-1 font-label-sm text-label-sm text-secondary">
                    <span class="material-symbols-outlined text-[14px]">call</span>
                    <span>Müşteri teyidi bekliyor</span>
                </div>
            </div>
            <!-- Card 4: 3rd Attempt (Critical Return) -->
            <div class="rounded-xl bg-error-container p-space-md shadow-sm relative overflow-hidden flex flex-col justify-between text-on-error-container">
                <div class="flex items-center justify-between">
                    <span class="font-label-md text-label-md uppercase tracking-wider font-bold">3. Başarısız Deneme</span>
                    <span class="px-2 py-0.5 rounded-full font-label-sm text-label-sm bg-error text-on-error uppercase font-bold">3 / 3 Kritik</span>
                </div>
                <div class="mt-3 flex items-baseline gap-space-xs">
                    <span class="font-headline-xl text-headline-xl text-on-error-container">2</span>
                    <span class="font-body-sm text-body-sm text-on-error-container opacity-90">iade onayı bekleyen</span>
                </div>
                <div class="mt-2 flex items-center gap-1 font-label-sm text-label-sm font-semibold">
                    <span class="material-symbols-outlined text-[14px]">assignment_returned</span>
                    <span>İade prosedürü otomatik tetiklendi</span>
                </div>
            </div>
        </div>
        <!-- Operational Filter Strip & Quick Search -->
        <div class="rounded-xl bg-surface-container-lowest p-space-md shadow-sm mb-6 flex flex-col gap-space-md">
            <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-space-md">
                <!-- Search Input -->
                <div class="relative flex-1">
                    <span class="absolute inset-y-0 left-0 pl-space-sm flex items-center pointer-events-none text-secondary">
                        <span class="material-symbols-outlined text-[20px]">search</span>
                    </span>
                    <input class="w-full pl-9 pr-24 py-space-xs rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md placeholder:text-secondary focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary shadow-sm transition-all" id="kargoSearchInput" onkeyup="filterCargoes()" placeholder="Takip No (MYC-...), Alıcı Adı, Telefon veya Mahalle ara..." type="text" />
                    <div class="absolute inset-y-0 right-0 pr-space-xs flex items-center">
                        <span class="px-1.5 py-0.5 rounded bg-surface-container font-code-dense text-[10px] text-secondary">ESC temizle</span>
                    </div>
                </div>
                <!-- Quick Toggles -->
                <div class="flex items-center gap-space-xs flex-wrap">
                    <span class="font-label-sm text-label-sm uppercase text-secondary">Deneme:</span>
                    <button class="attempt-btn px- space-xs px-2.5 py-1 rounded-full font-label-md text-label-md bg-primary text-on-primary shadow-sm transition-colors" onclick="setAttemptFilter('all', this)">Tümü (12)</button>
                    <button class="attempt-btn px- space-xs px-2.5 py-1 rounded-full font-label-md text-label-md bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors" onclick="setAttemptFilter('1', this)">1. Deneme (7)</button>
                    <button class="attempt-btn px- space-xs px-2.5 py-1 rounded-full font-label-md text-label-md bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors" onclick="setAttemptFilter('2', this)">2. Deneme (3)</button>
                    <button class="attempt-btn px- space-xs px-2.5 py-1 rounded-full font-label-md text-label-md bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors" onclick="setAttemptFilter('3', this)">3. Deneme / İade (2)</button>
                </div>
            </div>
            <!-- Reason Select Pill Strip -->
            <div class="flex items-center gap-space-xs flex-wrap pt-space-xs">
                <span class="font-label-sm text-label-sm uppercase text-secondary mr-1">Hata Nedeni:</span>
                <button class="reason-btn px- space-xs px-2.5 py-1 rounded-lg font-label-md text-label-md bg-secondary text-on-secondary transition-colors" onclick="setReasonFilter('all', this)">Tümü</button>
                <button class="reason-btn px- space-xs px-2.5 py-1 rounded-lg font-label-md text-label-md bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high transition-colors" onclick="setReasonFilter('absent', this)">Alıcı Adreste Bulunamadı</button>
                <button class="reason-btn px- space-xs px-2.5 py-1 rounded-lg font-label-md text-label-md bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high transition-colors" onclick="setReasonFilter('address', this)">Adres Yetersiz / Yanlış</button>
                <button class="reason-btn px- space-xs px-2.5 py-1 rounded-lg font-label-md text-label-md bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high transition-colors" onclick="setReasonFilter('rejected', this)">Alıcı Kabul Etmedi / Hasarlı</button>
                <button class="reason-btn px- space-xs px-2.5 py-1 rounded-lg font-label-md text-label-md bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high transition-colors" onclick="setReasonFilter('appointment', this)">Randevulu Teslimat Talebi</button>
            </div>
        </div>
        <!-- Operational Exception List -->
        <div class="flex flex-col gap-space-md" id="cargoListContainer">
            @foreach (var item in Model)
            {
                <div class="cargo-card rounded-xl bg-surface-container-lowest p-space-md shadow-sm transition-all hover:shadow-md flex flex-col gap-space-md"
                     data-attempt="@item.FailedAttemptCount"
                     data-search="@item.TrackCode.ToLower() @item.ReceiverName.ToLower()">

                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-sm pb-space-xs">
                        <div class="flex items-center gap-space-sm flex-wrap">
                            <div class="w-9 h-9 rounded-lg bg-surface-container-low flex items-center justify-center text-primary">
                                <span class="material-symbols-outlined text-[20px]">person_off</span>
                            </div>
                            <div class="flex flex-col">
                                <div class="flex items-center gap-space-xs">
                                    <span class="font-code-dense text-code-dense text-on-surface font-bold">@item.TrackCode</span>
                                    <span class="px-space-xs py-0.5 rounded-full font-label-sm text-label-sm bg-surface-container-high text-primary font-bold">
                                        @item.FailedAttemptCount / 3 Deneme
                                    </span>
                                    <span class="px-space-xs py-0.5 rounded-full font-label-sm text-label-sm bg-secondary-container text-on-secondary-container">
                                        @item.CargoType.GetDisplayName()
                                    </span>
                                </div>
                                <span class="font-label-lg text-label-lg text-on-surface">@item.ReceiverName</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-space-md self-start lg:self-center">
                            <div class="flex items-center gap-space-xs text-secondary font-body-sm text-body-sm">
                                <span class="material-symbols-outlined text-[16px] text-primary">two_wheeler</span>
                                <span>Kurye: <strong class="text-on-surface font-label-md">Ahmet Yılmaz</strong></span>
                            </div>
                            <span class="px-2 py-0.5 rounded-full font-label-sm text-label-sm bg-surface-container-high text-on-surface-variant font-semibold">
                                @item.CargoStatus.GetDisplayName()
                            </span>
                        </div>
                    </div>

                    <!-- Deneme Kotası -->
                    <div class="md:col-span-3 flex flex-col justify-center">
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-label-sm text-label-sm uppercase text-secondary">Deneme Kotası</span>
                            <span class="font-code-dense text-[11px] font-bold text-primary">@item.FailedAttemptCount / 3</span>
                        </div>
                        <div class="w-full bg-surface-container-high h-2 rounded-full overflow-hidden flex">
                            @for (int i = 0; i < 3; i++)
                            {
                                <div class="@(i < item.FailedAttemptCount ? "bg-primary" : "bg-transparent") w-1/3 h-full"></div>
                            }
                        </div>
                        <span class="font-body-sm text-[11px] text-primary mt-1 font-semibold">
                            @(3 - item.FailedAttemptCount) deneme hakkı daha var
                        </span>
                    </div>

                    <!-- Action Footer -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm pt-space-xs">
                        <div class="flex items-center gap-space-xs flex-wrap">
                            @if (item.FailedAttemptCount < 3)
                            {
                                <a asp-area="Manager" asp-controller="Cargo" asp-action="AddMovement" asp-route-id="@item.Id"
                                   class="flex items-center gap-1 px-space-md py-space-xs rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:opacity-90 shadow-sm transition-all">
                                    <span class="material-symbols-outlined text-[16px]">event_repeat</span>
                                    <span>Tekrar Dağıtıma Çıkar</span>
                                </a>
                            }
                            @if (item.FailedAttemptCount >= 3)
                            {
                                <a asp-area="Manager" asp-controller="Cargo" asp-action="InitiateReturn" asp-route-id="@item.Id"
                                   class="flex items-center gap-1 px-space-md py-space-xs rounded-lg bg-error text-on-error font-label-md text-label-md hover:opacity-90 shadow-sm transition-all">
                                    <span class="material-symbols-outlined text-[16px]">assignment_return</span>
                                    <span>İade Başlat</span>
                                </a>
                            }
                            <a asp-area="Manager" asp-controller="Cargo" asp-action="AddMovement" asp-route-id="@item.Id"
                               class="p-space-xs rounded-lg bg-surface-container-low text-secondary hover:text-on-surface hover:bg-surface-container-high transition-colors"
                               title="Detayları Görüntüle">
                                <span class="material-symbols-outlined text-[18px]">more_vert</span>
                            </a>
                        </div>
                    </div>
                </div>
            }

        </div>
        <!-- Resolution / Address Update Modal Backdrop -->
        <div class="fixed inset-0 bg-inverse-surface/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-space-md" id="actionModal">
            <div class="w-full max-w-xl rounded-xl bg-surface-container-lowest shadow-xl flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-150">
                <div class="p-space-md bg-surface-container-low flex items-center justify-between">
                    <div class="flex items-center gap-space-xs">
                        <div class="w-8 h-8 rounded-lg bg-primary text-on-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-[20px]" id="modalIcon">edit_location</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-headline-sm text-headline-sm text-on-surface" id="modalTitle">Adres Bilgisini Güncelle</span>
                            <span class="font-code-dense text-code-dense text-secondary" id="modalSubtitle">MYC-2026-512994 • Aylin Sönmez</span>
                        </div>
                    </div>
                    <button class="w-8 h-8 rounded-lg flex items-center justify-center text-secondary hover:text-on-surface hover:bg-surface-container transition-colors" onclick="closeActionModal()">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>
                <div class="p-space-lg flex flex-col gap-space-md">
                    <div class="p-space-sm rounded-lg bg-surface-container-low flex items-start gap-space-xs">
                        <span class="material-symbols-outlined text-primary text-[18px] mt-0.5">info</span>
                        <p class="font-body-sm text-body-sm text-on-surface">
                            Güncellenen adres bilgisi derhal dağıtım tabletine ve kuryenin rotasına anlık yansıtılacaktır.
                        </p>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="font-label-sm text-label-sm uppercase text-secondary">Açık Adres &amp; Daire / Bina Bilgisi</label>
                        <textarea class="w-full p-space-sm rounded-lg bg-surface text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary shadow-sm" id="modalAddressTextarea" rows="3"></textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-space-sm">
                        <div class="flex flex-col gap-1">
                            <label class="font-label-sm text-label-sm uppercase text-secondary">İrtibat Teyit Edildi mi?</label>
                            <select class="p-space-xs rounded-lg bg-surface text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary">
                                <option>Telefonla Müşteri Onayı Alındı</option>
                                <option>Müşteri SMS Cevap Formu</option>
                                <option>Gönderici Teyidi Alındı</option>
                                <option>Şube Personeli Tarafından Doğrulandı</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="font-label-sm text-label-sm uppercase text-secondary">Sonraki Dağıtım Zamanı</label>
                            <select class="p-space-xs rounded-lg bg-surface text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary">
                                <option>Yarın Sabah Seferi (09:00 - 13:00)</option>
                                <option>Yarın Öğleden Sonra (13:00 - 18:00)</option>
                                <option>Bugün Ek Sefer (Acil)</option>
                            </select>
                        </div>
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="font-label-sm text-label-sm uppercase text-secondary">Operasyonel Çözüm Notu (Zorunlu)</label>
                        <input class="p-space-xs rounded-lg bg-surface text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Örn: Müşteri arandı, daire no 8 olarak güncellendi." type="text" value="Müşteri telefonla arandı, bina ve kapı no netleştirildi." />
                    </div>
                </div>
                <div class="p-space-md bg-surface-container-low flex items-center justify-between">
                    <button class="px-space-md py-space-xs rounded-lg font-label-md text-label-md text-secondary hover:text-on-surface transition-colors" onclick="closeActionModal()">
                        İptal
                    </button>
                    <button class="flex items-center gap-1.5 px-space-md py-space-xs rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:opacity-90 shadow-sm transition-all" onclick="saveModalAction()">
                        <span class="material-symbols-outlined text-[18px]">task_alt</span>
                        <span>Kaydet &amp; Dağıtıma Al</span>
                    </button>
                </div>
            </div>
        </div>
        <!-- Toast Notification Indicator -->
        <div class="fixed bottom-6 right-6 z-50 hidden items-center gap-space-xs px-space-md py-space-sm rounded-xl bg-on-surface text-surface shadow-xl animate-in slide-in-from-bottom duration-200" id="actionToast">
            <span class="material-symbols-outlined text-primary-fixed text-[20px]" id="toastIcon">check_circle</span>
            <span class="font-label-md text-label-md" id="toastMessage">İşlem başarıyla tamamlandı.</span>
        </div>
    </div>
    <script>
                let currentAttempt = 'all';
                let currentReason = 'all';

                function setAttemptFilter(val, btn) {
                    currentAttempt = val;
                    document.querySelectorAll('.attempt-btn').forEach(b => {
                        b.className = 'attempt-btn px-2.5 py-1 rounded-full font-label-md text-label-md bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors';
                    });
                    btn.className = 'attempt-btn px-2.5 py-1 rounded-full font-label-md text-label-md bg-primary text-on-primary shadow-sm transition-colors';
                    filterCargoes();
                }

                function setReasonFilter(val, btn) {
                    currentReason = val;
                    document.querySelectorAll('.reason-btn').forEach(b => {
                        b.className = 'reason-btn px-2.5 py-1 rounded-lg font-label-md text-label-md bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high transition-colors';
                    });
                    btn.className = 'reason-btn px-2.5 py-1 rounded-lg font-label-md text-label-md bg-secondary text-on-secondary transition-colors';
                    filterCargoes();
                }

                function filterCargoes() {
                    const searchVal = (document.getElementById('kargoSearchInput').value || '').toLowerCase().trim();
                    const cards = document.querySelectorAll('.cargo-card');

                    cards.forEach(card => {
                        const cardAttempt = card.getAttribute('data-attempt');
                        const cardReason = card.getAttribute('data-reason');
                        const cardSearch = (card.getAttribute('data-search') || '').toLowerCase();

                        const matchAttempt = (currentAttempt === 'all') || (cardAttempt === currentAttempt);
                        const matchReason = (currentReason === 'all') || (cardReason === currentReason);
                        const matchSearch = (!searchVal) || cardSearch.includes(searchVal);

                        if (matchAttempt && matchReason && matchSearch) {
                            card.style.display = 'flex';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                }

                function openAddressUpdateModal(trackingNo, customer, currentAddress) {
                    document.getElementById('modalTitle').textContent = 'Adres Bilgisini Güncelle';
                    document.getElementById('modalSubtitle').textContent = trackingNo + ' • ' + customer;
                    document.getElementById('modalAddressTextarea').value = currentAddress;
                    document.getElementById('actionModal').classList.remove('hidden');
                }

                function closeActionModal() {
                    document.getElementById('actionModal').classList.add('hidden');
                }

                function saveModalAction() {
                    closeActionModal();
                    showToast('Adres güncellendi ve kargo yarınki sabah dağıtım planına eklendi.');
                }

                function scheduleNextDelivery(trackingNo, customer) {
                    showToast(trackingNo + ' (' + customer + ') yarınki dağıtım listesine aktarıldı.');
                }

                function openBranchPickupNotify(trackingNo, customer) {
                    showToast(customer + ' kişisine şubeden teslim SMS bildirimi iletildi.');
                }

                function startReturnDispatch(trackingNo, customer) {
                    if (confirm(trackingNo + ' nolu kargo için İade Transfer İrsaliyesi kesilecek ve çıkış şubesine sevk edilecek. Onaylıyor musunuz?')) {
                        showToast(trackingNo + ' için Gönderici Şubeye İade Süreci başlatıldı (Transfer Kodu: TR-' + Math.floor(1000 + Math.random() * 9000) + ').', 'local_shipping');
                    }
                }

                function sendAddressLinkSMS(trackingNo, phone) {
                    showToast(trackingNo + ' için ' + phone + ' numarasına anlık konum bildirim SMS\'i yollandı.');
                }

                function viewDamageReport(trackingNo) {
                    showToast(trackingNo + ' Hasar Tespit Tutanağı ve ekli belgeler açılıyor...', 'receipt_long');
                }

                function contactSender(trackingNo) {
                    showToast(trackingNo + ' gönderici çağrı merkezi santraline bağlanıyor...', 'phone_in_talk');
                }

                function downloadReportModal() {
                    showToast('Sorunlu Kargolar Raporu (Excel) hazırlanıyor ve indiriliyor...', 'file_download');
                }

                function openBatchReturnModal() {
                    showToast('3/3 denemesi dolan 2 kargo için Toplu İade İrsaliyesi oluşturuluyor...', 'assignment_return');
                }

                function quickDetailView(trackingNo) {
                    showToast(trackingNo + ' geçmiş hareket kaydı ve deneme detayları açıldı.', 'info');
                }

                function showToast(msg, icon = 'check_circle') {
                    const toast = document.getElementById('actionToast');
                    const toastMsg = document.getElementById('toastMessage');
                    const toastIcon = document.getElementById('toastIcon');

                    toastMsg.textContent = msg;
                    toastIcon.textContent = icon;
                    toast.classList.remove('hidden');
                    toast.classList.add('flex');

                    setTimeout(() => {
                        toast.classList.add('hidden');
                        toast.classList.remove('flex');
                    }, 3800);
                }

                // Keyboard shortcut ESC to clear search
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        const search = document.getElementById('kargoSearchInput');
                        if (search && document.activeElement === search) {
                            search.value = '';
                            filterCargoes();
                        } else {
                            closeActionModal();
                        }
                    }
                });
    </script>
</main>
</div>
