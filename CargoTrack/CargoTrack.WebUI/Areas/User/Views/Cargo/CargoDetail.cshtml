@using CargoTrack.Entity.Entities.Enums

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

<main class="w-full pt-20 bg-surface flex-1 px-space-xl py-space-lg">
    <div class="flex flex-col w-full">

        @await Component.InvokeAsync("_UserCargoDetailHeader", new { cargo = Model })

        <div class="fixed bottom-6 right-6 bg-inverse-surface text-inverse-on-surface px-4 py-3 rounded-xl shadow-xl z-50 flex items-center gap-2 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300 font-label-md text-label-md" id="toastNotification">
            <span class="material-symbols-outlined text-[18px] text-tertiary-fixed-dim">check_circle</span>
            <span>Takip numarası panoya kopyalandı!</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
            <div class="lg:col-span-8 flex flex-col gap-space-lg">

                @await Component.InvokeAsync("_UserCargoDetailLiveMap", new { cargo = Model })

                @await Component.InvokeAsync("_UserCargoDetailTimeline", new { cargoId = Model.Id })

            </div>
            <div class="lg:col-span-4 flex flex-col gap-space-lg">

                @await Component.InvokeAsync("_UserCargoDetailSummary", new { cargo = Model })

                <div class="bg-surface-container-lowest p-5 rounded-2xl border border-outline-variant/30 shadow-sm">
                    <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20 mb-3.5">
                        <span class="text-xs font-bold text-on-surface uppercase tracking-wider flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px] text-primary">verified_user</span>
                            Teslimat Doğrulama
                        </span>
                        <span class="text-[11px] font-semibold text-secondary">SLA & Güvenlik</span>
                    </div>

                    @if (Model.CargoStatus == CargoStatus.OutForDelivery && !string.IsNullOrWhiteSpace(Model.DeliveryCode))
                    {
                        <div class="p-3.5 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-center">
                            <span class="text-[11px] font-bold text-emerald-600 uppercase tracking-widest block mb-1">
                                Kuryeye İletilecek Kod
                            </span>
                            <div class="font-code text-2xl font-black tracking-widest text-emerald-600 my-1">
                                @Model.DeliveryCode
                            </div>
                            <p class="text-[11px] text-emerald-700/80 leading-tight mt-1">
                                Kuryemiz paketi teslim ederken bu 6 haneli kodu sözlü olarak iletiniz.
                            </p>
                        </div>
                    }
                    else if (Model.CargoStatus == CargoStatus.Delivered)
                    {
                        <div class="p-3.5 bg-surface-container-low border border-outline-variant/20 rounded-xl flex items-center gap-3">
                            <div class="w-9 h-9 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-[20px]">check_circle</span>
                            </div>
                            <div>
                                <span class="text-xs font-bold text-on-surface block">Teslim Edildi</span>
                                <span class="text-[11px] text-secondary">Kod doğrulaması yapıldı ve paket teslim alındı.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-3.5 bg-surface-container-low border border-outline-variant/20 rounded-xl flex items-center gap-3">
                            <div class="w-9 h-9 rounded-lg bg-surface-container-high text-outline flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-[20px]">lock</span>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-on-surface block">Teslimat Kodu Kilitli</span>
                                <span class="text-[11px] text-secondary leading-tight block mt-0.5">
                                    Paket varış şubesinden kurye ile dağıtıma çıktığında kod aktifleşecektir.
                                </span>
                            </div>
                        </div>
                    }
                </div>

                <div class="bg-surface-container-lowest p-5 rounded-2xl border border-outline-variant/30 shadow-sm">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold text-on-surface uppercase tracking-wider flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px] text-indigo-500">shield</span>
                            Teslimat Güvencesi & İstisna
                        </span>
                        <span class="text-[11px] font-semibold @(Model.FailedAttemptCount > 0 ? "text-amber-500 font-bold" : "text-secondary")">
                            Deneme: @Model.FailedAttemptCount / 3
                        </span>
                    </div>

                    <div class="grid grid-cols-3 gap-2 mb-3">
                        @for (int i = 1; i <= 3; i++)
                        {
                            var isFailedStep = Model.FailedAttemptCount >= i;
                            <div class="h-2 rounded-full transition-all @(isFailedStep ? "bg-rose-500" : "bg-surface-container-high")"
                                 title="@(isFailedStep ? $"{i}. Deneme Başarısız" : $"{i}. Hak Temiz")">
                            </div>
                        }
                    </div>

                    @if (Model.FailedAttemptCount > 0)
                    {
                        <div class="p-3 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-500 text-xs">
                            <div class="flex items-center gap-1.5 font-bold mb-1">
                                <span class="material-symbols-outlined text-[16px]">warning</span>
                                <span>@(Model.FailedAttemptCount == 3 ? "İade Süreci Başlatıldı!" : "Adreste Bulunamadı")</span>
                            </div>
                            <p class="text-[11px] text-rose-600/90 leading-relaxed">
                                @(Model.LastExceptionDescription ?? "Adrese gidildi fakat alıcıya ulaşılamadı. 3 başarısız deneme sonunda kargo göndericiye iade edilir.")
                            </p>
                        </div>
                    }
                    else
                    {
                        <p class="text-xs text-secondary leading-relaxed">
                            Kargonuz kurumsal SLA standartlarımız kapsamında korunmaktadır. Teslimat adresine 3 kez uğrama güvencesi sunulur.
                        </p>
                    }

                    <div class="mt-4 pt-3 border-t border-outline-variant/20 flex items-center justify-between text-xs text-secondary">
                        <span>Varış Şubesi:</span>
                        <span class="font-semibold text-on-surface">@Model.DestinationBranchName</span>
                    </div>
                </div>

                <!-- Branch Support Info Card -->
                @await Component.InvokeAsync("_UserCargoDetailBranchInfo", new { cargo = Model })

            </div>
        </div>
    </div>
    <script>
                        function showToast() {
                        const toast = document.getElementById('toastNotification');
                        if (!toast) return;
                        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
                        toast.classList.add('translate-y-0', 'opacity-100');
                            setTimeout(() => {
                            toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
                            toast.classList.remove('translate-y-0', 'opacity-100');
                        }, 2500);
                    }

                    function toggleFlexOption(el) {
                        const hiddenPanel = el.querySelector('div:last-child');
                        if (!hiddenPanel) return;
                        const isHidden = hiddenPanel.classList.contains('hidden');
            // Close other panels inside parent
            el.parentElement.querySelectorAll('.p-3\\.5 > div:last-child').forEach(panel => {
                panel.classList.add('hidden');
            });
            if (isHidden) {
                hiddenPanel.classList.remove('hidden');
                        }
                    }
    </script>
</main>
</div>
