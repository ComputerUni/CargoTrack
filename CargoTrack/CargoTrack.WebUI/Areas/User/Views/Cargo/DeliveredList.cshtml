@model List<ResultCargoDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<main class="w-full pt-20 bg-surface flex-1 px-space-xl py-space-lg">
    <div class="flex flex-col w-full">
        <div class="flex flex-col gap-8 pb-12">

            @await Component.InvokeAsync("_UserCargoDeliveredListHeader")

            @* @await Component.InvokeAsync("_UserCargoDeliveredListFilterTabs") *@

            @await Component.InvokeAsync("_UserCargoDeliveredListSearchFilter")

            @await Component.InvokeAsync("_UserCargoDeliveredListTable", new { cargos = Model, page = Context.Request.Query["page"].ToString() == "" ? 1 : int.Parse(Context.Request.Query["page"]) })

            @await Component.InvokeAsync("_UserCargoActiveListRouteMap", new { cargo = Model?.FirstOrDefault() })

        </div>
    </div>
</main>
