@model List<ResultCargoDto>
@using CargoTrack.Business.Extensions
@using CargoTrack.Entity.Entities.Enums

<div class="flex flex-col gap-4" id="sent-shipment-container">
    @if (Model == null || !Model.Any())
    {
        <div class="bg-surface-container-lowest rounded-2xl p-10 text-center flex flex-col items-center justify-center border border-outline-variant/30">
            <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center text-outline mb-3">
                <span class="material-symbols-outlined text-[32px]">outbox</span>
            </div>
            <h3 class="font-headline-sm text-on-surface font-bold">Giden Kargo Bulunamadı</h3>
            <p class="font-body-sm text-on-surface-variant mt-1 max-w-sm">Henüz sistem üzerinden gönderici olduğunuz bir kargo kaydı bulunmuyor.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            var (badgeBg, badgeText, statusText) = item.CargoStatus switch
            {
                CargoStatus.Delivered => ("bg-emerald-500/10 border-emerald-500/30", "text-emerald-400", "Alıcıya Teslim Edildi"),
                CargoStatus.OutForDelivery => ("bg-blue-500/10 border-blue-500/30", "text-blue-400", "Dağıtıma Çıktı"),
                CargoStatus.DeliveryFailed => ("bg-amber-500/10 border-amber-500/30", "text-amber-400", "Teslim Edilemedi"),
                CargoStatus.ReturnInProcess => ("bg-rose-500/10 border-rose-500/30", "text-rose-400", "İade Sürecinde"),
                CargoStatus.ReturnedToSender => ("bg-slate-500/10 border-slate-500/30", "text-slate-300", "Göndericiye İade Edildi"),
                CargoStatus.InTransferCenter => ("bg-indigo-500/10 border-indigo-500/30", "text-indigo-400", "Transfer Merkezinde"),
                CargoStatus.ArrivedAtDeliveryBranch => ("bg-cyan-500/10 border-cyan-500/30", "text-cyan-400", "Varış Şubesinde"),
                CargoStatus.AtOriginBranch => ("bg-teal-500/10 border-teal-500/30", "text-teal-400", "Gönderici Şubesinde"),
                _ => ("bg-surface-container-high border-outline-variant/30", "text-on-surface-variant", item.CargoStatus.GetDisplayName())
            };

            <article class="group relative bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/20 hover:border-primary/40 shadow-sm hover:shadow-md transition-all">
                <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-5">

                    <!-- Takip No & Hat Bilgisi -->
                    <div class="flex items-start gap-4 min-w-[290px]">
                        <div class="w-12 h-12 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary flex-shrink-0">
                            <span class="material-symbols-outlined text-[24px]">outbox</span>
                        </div>
                        <div class="flex flex-col min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="font-code text-body-lg text-primary font-bold tracking-tight">@item.TrackCode</span>
                                <span class="text-[11px] px-2 py-0.5 rounded-md bg-surface-container font-medium text-on-surface-variant uppercase tracking-wider">
                                    @item.CargoType.ToString()
                                </span>
                            </div>
                            <div class="flex items-center gap-1.5 text-on-surface-variant font-body-sm mt-1">
                                <span class="material-symbols-outlined text-[15px] text-outline">storefront</span>
                                <span class="text-on-surface font-medium">@item.OriginBranchName</span>
                                <span class="text-outline text-xs">→</span>
                                <span class="text-on-surface font-medium">@item.DestinationBranchName</span>
                            </div>
                            <div class="text-xs text-on-surface-variant mt-1">
                                Gönderim: <span class="text-on-surface">@item.ShipmentDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Alıcı Bilgileri & Teslimat Adresi -->
                    <div class="flex flex-col min-w-[220px]">
                        <span class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1">Alıcı Bilgileri</span>
                        <div class="flex items-center gap-1.5 text-on-surface font-medium font-body-sm">
                            <span class="material-symbols-outlined text-[16px] text-primary">person</span>
                            <span class="truncate">@item.ReceiverName</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.ReceiverPhone))
                        {
                            <div class="flex items-center gap-1.5 text-xs text-on-surface-variant mt-0.5">
                                <span class="material-symbols-outlined text-[14px]">call</span>
                                <span>@item.ReceiverPhone</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.DeliveryAddressDetail))
                        {
                            <span class="text-xs text-outline line-clamp-1 mt-0.5" title="@item.DeliveryAddressDetail">
                                @item.DeliveryAddressDetail
                            </span>
                        }
                    </div>

                    <!-- Paket & Fiyat -->
                    <div class="flex flex-col min-w-[140px]">
                        <span class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1">Paket Özeti</span>
                        <div class="text-sm font-semibold text-on-surface">@item.Desi.ToString("N2") Desi <span class="text-outline font-normal">/</span> @item.Weight.ToString("N1") kg</div>
                        <div class="text-sm font-bold text-primary mt-0.5">@item.Price.ToString("C2")</div>
                    </div>

                    <!-- Durum & Tahmini Teslimat -->
                    <div class="flex flex-col min-w-[190px]">
                        <span class="inline-flex items-center gap-1.5 w-fit px-3 py-1 rounded-full text-xs font-bold border @badgeBg @badgeText mb-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                            @statusText
                        </span>
                        <div class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px] text-outline">event</span>
                            <div class="flex flex-col">
                                <span class="text-xs text-outline">Tahmini Teslimat</span>
                                <span class="text-sm font-bold text-on-surface">@item.EstimatedArrivalDate.ToString("dd MMMM yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Aksiyon -->
                    <div class="flex items-center justify-end">
                        <a asp-area="User" asp-controller="Cargo" asp-action="CargoDetail" asp-route-id="@item.Id"
                           class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface hover:text-primary text-sm font-semibold transition-all">
                            <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                            <span>Detay</span>
                        </a>
                    </div>

                </div>

                @if (item.FailedAttemptCount > 0)
                {
                    <div class="mt-3 pt-3 border-t border-outline-variant/20 flex items-center justify-between text-xs text-amber-400 bg-amber-500/5 px-3 py-2 rounded-xl border border-amber-500/20">
                        <div class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px]">warning</span>
                            <span>Teslimat denemesi başarısız oldu (@item.FailedAttemptCount. deneme) - @(item.LastExceptionReason?.ToString() ?? "Adreste bulunamadı")</span>
                        </div>
                        @if (item.LastExceptionDate.HasValue)
                        {
                            <span class="text-on-surface-variant font-code">@item.LastExceptionDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </div>
                }
            </article>
        }
    }
</div>