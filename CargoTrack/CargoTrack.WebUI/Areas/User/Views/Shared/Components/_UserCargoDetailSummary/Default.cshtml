@using CargoTrack.Business.Extensions
@model ResultCargoDto

<div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-[0_1px_3px_0_rgba(15,23,42,0.04)]">
    <div class="flex items-center justify-between pb-space-sm mb-space-md bg-surface-container-high/40 -mx-space-lg px-space-lg py-2 rounded-t-xl">
        <span class="font-label-lg text-label-lg text-on-surface font-semibold flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px] text-primary">inventory_2</span>
            <span>Gönderi Özeti</span>
        </span>
        <span class="text-label-sm font-label-sm text-primary font-bold">@Model.CargoType.GetDisplayName()</span>
    </div>
    <div class="space-y-3.5">
        <div class="flex items-start justify-between gap-2">
            <span class="font-body-sm text-body-sm text-secondary">Gönderici</span>
            <span class="font-label-md text-label-md text-on-surface text-right font-semibold">@Model.OriginBranchName</span>
        </div>
        <div class="flex items-start justify-between gap-2">
            <span class="font-body-sm text-body-sm text-secondary">Alıcı</span>
            <span class="font-label-md text-label-md text-on-surface text-right font-semibold">@Model.ReceiverName (Siz)</span>
        </div>
        <div class="flex items-start justify-between gap-2">
            <span class="font-body-sm text-body-sm text-secondary">Ağırlık / Desi</span>
            <span class="font-label-md text-label-md text-on-surface text-right">@Model.Desi.ToString("N2") Desi <span class="text-secondary">(@Model.Weight gr)</span></span>
        </div>
        <div class="flex items-start justify-between gap-2">
            <span class="font-body-sm text-body-sm text-secondary">Ödeme Durumu</span>
            <span class="inline-flex items-center gap-1 font-label-md text-label-md text-on-surface bg-surface-container-high px-2 py-0.5 rounded-lg">
                <span class="material-symbols-outlined text-[14px] text-primary">check_circle</span>
                Gönderici Ödemeli
            </span>
        </div>
        <div class="flex items-start justify-between gap-2">
            <span class="font-body-sm text-body-sm text-secondary">İçerik Türü</span>
            <span class="font-label-md text-label-md text-on-surface text-right">@Model.CargoType.GetDisplayName()</span>
        </div>
    </div>
    <div class="mt-space-md pt-space-md bg-surface-container-low p-3 rounded-xl flex items-center gap-3">
        <img class="w-12 h-12 rounded-lg object-cover shadow-sm" data-alt="Small neat packaged brown cardboard e-commerce parcel box with fragile glass symbol and high priority logistics label, clean studio product shot" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCxOcLTR9sl0USoHR34zbxynuReBUVgvg3_m0anh2MT5-xcyV2i9MOo9pvbaQPD6gy_DOtGhRw0a7TYSPGoWk8881J5J9jY96HmxHORw0TAw9TmDVzvLJPhqgxEfJqF0gnhoQGrEu6liig-AYliFKxCqxDBPuaD1gfo-heAQuKIvztvsGKKZuIezxhV6Xy6MCN-_UHp-3TGzV66KwrAlCjZJ95ZS-f1xzqHBT4A_89oFmKAp11ocLc89Q" />
        <div class="min-w-0 flex-1">
            <span class="font-label-sm text-label-sm text-secondary block">Sipariş No: @Model.TrackCode</span>
        </div>
    </div>
</div>