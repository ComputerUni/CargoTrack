@using CargoTrack.Business.Extensions
@using CargoTrack.Entity.Entities.Enums
@model List<CargoTrack.DTO.DTOs.CargosDtos.ResultCargoDto>

<div class="flex flex-col gap-3 w-full">
    <!-- Başlık ve Tümünü Gör Linki -->
    <div class="flex items-center justify-between">
        <h2 class="text-base font-bold text-on-surface">Son Kargo Hareketleri</h2>
    </div>

    <!-- Liste Kartı Kapsayıcısı -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 shadow-sm flex flex-col overflow-hidden w-full">
        @if (Model == null || !Model.Any())
        {
            <div class="p-8 text-center text-secondary text-xs">
                Henüz kayıtlı bir kargo hareketiniz bulunmuyor.
            </div>
        }
        else
        {
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                var isIncoming = item.ReceiverId == (Guid)(ViewBag.CurrentUserId ?? Guid.Empty);
                var lastMovement = item.CargoMovements?.OrderByDescending(m => m.CreatedDate).FirstOrDefault();

                <div class="p-4 flex items-center justify-between gap-4 hover:bg-surface-container-low transition-colors w-full">
                    <!-- Sol Kısım: İkon + Metin Bilgileri -->
                    <div class="flex items-center gap-3.5 min-w-0">
                        <div class="w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-[22px]">package_2</span>
                        </div>

                        <div class="flex flex-col min-w-0">
                            <!-- Satır 1: Başlık, Takip Kodu ve Rozet -->
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="font-bold text-sm text-on-surface truncate">
                                    @item.CargoType.GetDisplayName()
                                </span>

                                <a asp-area="User" asp-controller="Cargo" asp-action="CargoDetail" asp-route-id="@item.Id"
                                   class="font-mono text-xs text-secondary hover:text-primary transition-colors bg-surface-container-low px-2 py-0.5 rounded border border-outline-variant/20">
                                    @item.TrackCode
                                </a>

                                @if (isIncoming)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                                        Gelen
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-primary/10 text-primary border border-primary/20">
                                        Gönderdiğim
                                    </span>
                                }
                            </div>

                            <!-- Satır 2: Son Hareket / Güzergah Açıklaması -->
                            <span class="text-xs text-secondary font-medium mt-1 truncate">
                                @if (lastMovement != null)
                                {
                                    <span>@lastMovement.Description • @(lastMovement.BranchName ?? lastMovement.TransferCenterName)</span>
                                }
                                else
                                {
                                    <span>@item.OriginBranchName → @item.DestinationBranchName</span>
                                }
                            </span>
                        </div>
                    </div>

                    <!-- Sağ Kısım: Tarih ve Durum Bilgisi -->
                    <div class="flex flex-col items-end shrink-0 pl-2">
                        <span class="text-xs font-semibold text-on-surface font-mono">
                            @(lastMovement != null ? lastMovement.CreatedDate : item.CreatedDate)
                        </span>
                        <span class="text-[11px] font-medium text-outline mt-0.5">
                            @item.CargoStatus.GetDisplayName()
                        </span>
                    </div>
                </div>

                @if (i < Model.Count - 1)
                {
                    <div class="h-px bg-outline-variant/20 w-full"></div>
                }
            }
        }
    </div>
</div>