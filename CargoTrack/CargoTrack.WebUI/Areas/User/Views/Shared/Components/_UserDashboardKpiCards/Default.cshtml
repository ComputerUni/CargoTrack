<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
    <!-- KPI 1: Aktif / Yoldaki Kargolar -->
    <div class="p-space-lg bg-surface-container-lowest rounded-xl shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
        <div class="flex flex-col">
            <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline mb-1">Aktif / Yoldaki Kargolar</span>
            <div class="font-headline-lg text-headline-lg text-on-surface leading-none mb-1">@ViewBag.ActiveCargoCount Paket</div>
            <span class="font-body-sm text-body-sm text-secondary">@ViewBag.OutOfDelivery Dağıtımda, @ViewBag.InTransferCenter Aktarmada</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center text-on-primary-fixed-variant shrink-0">
            <span class="material-symbols-outlined text-[24px]">local_shipping</span>
        </div>
    </div>
    <!-- KPI 2: Bana Gelen Kargolar -->
    <div class="p-space-lg bg-surface-container-lowest rounded-xl shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
        <div class="flex flex-col">
            <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline mb-1">Bana Gelen Kargolar</span>
            <div class="font-headline-lg text-headline-lg text-on-surface leading-none mb-1">@ViewBag.ReceivedCargos Paket</div>
            <div class="flex items-center gap-1.5 font-label-md text-label-md text-primary font-semibold">
                <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
                <span>Bugün Teslimatta</span>
            </div>
        </div>
        <div class="w-12 h-12 rounded-xl bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed shrink-0">
            <span class="material-symbols-outlined text-[24px]">move_to_inbox</span>
        </div>
    </div>
    <!-- KPI 3: Gönderdiğim Kargolar -->
    <div class="p-space-lg bg-surface-container-lowest rounded-xl shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
        <div class="flex flex-col">
            <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline mb-1">Gönderdiğim Kargolar</span>
            <div class="font-headline-lg text-headline-lg text-on-surface leading-none mb-1">@ViewBag.SentCargos Paket</div>
            <span class="font-body-sm text-body-sm text-secondary">Alıcısına Yolda</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed-variant shrink-0">
            <span class="material-symbols-outlined text-[24px]">outbox</span>
        </div>
    </div>
    <!-- KPI 4: Toplam Tamamlanan Teslimat -->
    <div class="p-space-lg bg-surface-container-lowest rounded-xl shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
        <div class="flex flex-col">
            <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline mb-1">Tamamlanan Teslimat</span>
            <div class="font-headline-lg text-headline-lg text-on-surface leading-none mb-1">@ViewBag.CompletedCargos Kargo</div>
            <span class="font-body-sm text-body-sm text-secondary">2026 Yılı İçerisinde</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-on-surface shrink-0">
            <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' 1;">verified</span>
        </div>
    </div>
</div>
