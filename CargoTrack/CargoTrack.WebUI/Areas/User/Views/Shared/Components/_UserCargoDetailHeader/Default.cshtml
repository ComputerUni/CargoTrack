@using CargoTrack.Business.Extensions
@using CargoTrack.Entity.Entities.Enums
@model ResultCargoDto

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-space-lg">
    <div class="flex flex-col gap-2">
        <a class="inline-flex items-center gap-1.5 text-secondary hover:text-primary transition-colors font-label-md text-label-md w-fit" href="/User/Cargo/ActiveList">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Kargolarıma Dön</span>
        </a>
        <div class="flex flex-wrap items-center gap-3">
            <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">Kargo Detayı:</h1>
            <div class="inline-flex items-center gap-2 bg-surface-container-high px-3 py-1.5 rounded-xl font-code-tracking text-code-tracking text-on-surface">
                <span id="trackingCodeText">@Model.TrackCode</span>
                <button class="text-secondary hover:text-primary transition-colors p-0.5 rounded flex items-center justify-center" id="copyBtn" onclick="navigator.clipboard.writeText('@Model.TrackCode'); showToast();" title="Takip Kodunu Kopyala">
                    <span class="material-symbols-outlined text-[18px]">content_copy</span>
                </button>
                <button class="text-secondary hover:text-primary transition-colors p-0.5 rounded flex items-center justify-center" title="QR Kod Göster">
                    <span class="material-symbols-outlined text-[18px]">qr_code_2</span>
                </button>
            </div>
            <!-- Pulse Status Badge -->
            <div class="inline-flex items-center gap-2 bg-secondary-container text-on-secondary-fixed px-3 py-1.5 rounded-xl font-label-md text-label-md shadow-sm">
                <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-container opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-primary-container"></span>
                </span>
                <span class="text-primary font-bold">@Model.CargoStatus.GetDisplayName()</span>
            </div>
        </div>
    </div>
    <!-- Quick Actions Header -->
    <div class="flex items-center gap-3 self-start md:self-auto">
        <button class="inline-flex items-center gap-2 px-space-md py-2.5 rounded-xl bg-surface-container-lowest text-on-surface hover:bg-surface-container-high transition-colors font-label-md text-label-md shadow-sm">
            <span class="material-symbols-outlined text-[18px] text-primary">download</span>
            <span>Fatura & Sevk İrsaliyesi (PDF)</span>
        </button>
        @if(Model.CargoStatus == CargoStatus.OutForDelivery)
        {
            <button class="inline-flex items-center gap-2 px-space-md py-2.5 rounded-xl bg-primary-container text-on-primary hover:bg-primary transition-colors font-label-md text-label-md shadow-sm" onclick="document.getElementById('smsCodeBox').scrollIntoView({behavior: 'smooth'})">
                <span class="material-symbols-outlined text-[18px]">pin</span>
                <span>Teslimat Kodunu Gör</span>
            </button>
        }
    </div>
</div>