@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<ResultCargoDto>
@using CargoTrack.Business.Extensions
@using CargoTrack.Entity.Entities.Enums

<div class="flex flex-col gap-4" id="active-shipment-container">
    @if (Model == null || !Model.Any())
    {
        <div class="bg-surface-container-lowest rounded-2xl p-10 text-center flex flex-col items-center justify-center border border-outline-variant/30">
            <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center text-outline mb-3">
                <span class="material-symbols-outlined text-[32px]">move_to_inbox</span>
            </div>
            <h3 class="font-headline-sm text-on-surface font-bold">Aktif Kargonuz Bulunmuyor</h3>
            <p class="font-body-sm text-on-surface-variant mt-1 max-w-sm">Şu an yolda olan veya adınıza teslimat bekleyen açık bir gönderi yok.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            var isOutForDelivery = item.CargoStatus == CargoStatus.OutForDelivery;

            var (badgeBg, badgeText, statusText) = item.CargoStatus switch
            {
                CargoStatus.OutForDelivery => ("bg-blue-500/10 border-blue-500/30", "text-blue-400", "Bugün Dağıtımda"),
                CargoStatus.ArrivedAtDeliveryBranch => ("bg-cyan-500/10 border-cyan-500/30", "text-cyan-400", "Varış Şubesinde"),
                CargoStatus.InTransferCenter => ("bg-indigo-500/10 border-indigo-500/30", "text-indigo-400", "Transfer Merkezinde"),
                CargoStatus.DeliveryFailed => ("bg-amber-500/10 border-amber-500/30", "text-amber-400", "Teslim Edilemedi"),
                CargoStatus.ReturnInProcess => ("bg-rose-500/10 border-rose-500/30", "text-rose-400", "İade Sürecinde"),
                _ => ("bg-surface-container-high border-outline-variant/30", "text-on-surface-variant", item.CargoStatus.GetDisplayName())
            };

            <article class="group relative bg-surface-container-lowest rounded-2xl p-5 border @(isOutForDelivery ? "border-blue-500/50 shadow-blue-500/5" : "border-outline-variant/20") hover:border-primary/40 shadow-sm hover:shadow-md transition-all">
                <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-5">

                    <div class="flex items-start gap-4 min-w-[280px]">
                        <div class="w-12 h-12 rounded-2xl @(isOutForDelivery ? "bg-blue-500/10 text-blue-400 border border-blue-500/20" : "bg-teal-500/10 text-teal-400 border border-teal-500/20") flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-outlined text-[24px]">@(isOutForDelivery ? "electric_moped" : "move_to_inbox")</span>
                        </div>
                        <div class="flex flex-col min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="font-code text-body-lg text-primary font-bold tracking-tight">@item.TrackCode</span>
                                @if (isOutForDelivery)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-500 text-white animate-pulse">
                                        Dağıtımda
                                    </span>
                                }
                            </div>
                            <div class="flex items-center gap-1.5 text-on-surface-variant font-body-sm mt-1">
                                <span class="material-symbols-outlined text-[15px] text-outline">location_on</span>
                                <span>Çıkış: <strong class="text-on-surface">@item.OriginBranchName</strong></span>
                                <span class="text-outline text-xs">→</span>
                                <span>Hedef: <strong class="text-on-surface">@item.DestinationBranchName</strong></span>
                            </div>
                            <div class="text-xs text-on-surface-variant mt-1">
                                Gönderici: <span class="text-on-surface font-medium">@item.SenderName</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col min-w-[220px]">
                        <span class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1">Dağıtım Sorumlusu</span>
                        @if (!string.IsNullOrWhiteSpace(item.AssignedCourierName))
                        {
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-full bg-surface-container flex items-center justify-center text-xs font-bold text-primary">
                                    @item.AssignedCourierName.Substring(0, 1)
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-sm font-semibold text-on-surface leading-tight">@item.AssignedCourierName</span>
                                    @if (!string.IsNullOrWhiteSpace(item.AssignedCourierPhone))
                                    {
                                        <span class="text-xs text-outline flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[12px]">call</span>
                                            @item.AssignedCourierPhone
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="text-xs text-on-surface-variant flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px] text-outline">schedule</span>
                                Şubede / Henüz Kurye Atanmadı
                            </span>
                        }
                    </div>

                    <div class="flex flex-col min-w-[190px]">
                        @if (!string.IsNullOrWhiteSpace(item.DeliveryCode))
                        {
                            <div class="flex flex-col mb-1.5">
                                <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[13px]">pin</span>
                                    6 Haneli Teslimat Kodu
                                </span>
                                <div class="font-code text-base font-extrabold text-emerald-400 tracking-widest bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-0.5 rounded-lg w-fit mt-0.5">
                                    @item.DeliveryCode
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 w-fit px-3 py-1 rounded-full text-xs font-bold border @badgeBg @badgeText mb-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                                @statusText
                            </span>
                        }

                        <div class="text-xs text-outline mt-0.5">
                            Tahmini Teslim: <strong class="text-on-surface">@item.EstimatedArrivalDate.ToString("dd MMM yyyy")</strong>
                        </div>
                    </div>

                    <div class="flex items-center justify-end">
                        <a href="/User/Cargo/CargoDetail/@item.Id"
                           class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-xl bg-primary text-on-primary hover:bg-primary/90 text-sm font-semibold shadow-sm transition-all">
                            <span class="material-symbols-outlined text-[18px]">timeline</span>
                            <span>Canlı Takip</span>
                        </a>
                    </div>

                </div>

                @if (item.FailedAttemptCount > 0)
                {
                    <div class="mt-3 pt-3 border-t border-outline-variant/20 flex items-center gap-2 text-xs text-rose-400 bg-rose-500/5 px-3 py-2 rounded-xl border border-rose-500/20">
                        <span class="material-symbols-outlined text-[16px]">info</span>
                        <span>Son denemede teslim edilemedi: <strong>@(item.LastExceptionDescription ?? item.LastExceptionReason?.ToString())</strong></span>
                    </div>
                }
            </article>
         
        }
    }
    @Html.PagedListPager(Model, page => "?page=" + page, new PagedListRenderOptions
    {
        UlElementClasses = new[] { "flex items-center gap-1 mt-6 justify-left" },
        LiElementClasses = new[] { "inline-flex" },
        PageClasses = new[] { "w-9 h-9 flex items-center justify-center rounded-xl border border-outline-variant text-sm font-semibold text-on-surface hover:bg-surface-container transition-colors" },
        PreviousElementClass = "w-9 h-9 flex items-center justify-center rounded-xl border border-outline-variant text-on-surface hover:bg-surface-container transition-colors",
        NextElementClass = "w-9 h-9 flex items-center justify-center rounded-xl border border-outline-variant text-on-surface hover:bg-surface-container transition-colors",
        DisplayLinkToFirstPage = PagedListDisplayMode.Never,
        DisplayLinkToLastPage = PagedListDisplayMode.Never,
        LinkToPreviousPageFormat = "←",
        LinkToNextPageFormat = "→"
    })
</div>