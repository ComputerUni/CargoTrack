@model List<ResultCargoDto>
@using CargoTrack.Business.Extensions
@using CargoTrack.Entity.Entities.Enums

<div class="flex flex-col gap-4" id="shipment-card-container">
    @foreach (var item in Model)
    {
        bool isIncoming = item.ReceiverId != Guid.Empty;

        <article class="shipment-row group relative bg-surface-container-lowest rounded-2xl p-5 shadow-sm hover:shadow-md transition-all"
                 data-type="@(item.SenderId != Guid.Empty ? "outgoing" : "incoming")">
            <div class="flex flex-col xl:flex-row items-stretch xl:items-center justify-between gap-5">

                <div class="flex items-start gap-4 min-w-[280px]">
                    <div class="w-12 h-12 rounded-2xl bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed flex-shrink-0 shadow-sm">
                        <span class="material-symbols-outlined text-[24px]">move_to_inbox</span>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-code-tracking text-code-tracking text-primary font-bold">@item.TrackCode</span>
                        </div>
                        <div class="flex items-center gap-2 text-secondary font-body-sm text-body-sm mt-0.5">
                            <span class="material-symbols-outlined text-[16px] text-outline">storefront</span>
                            <span>@item.OriginBranchName</span>
                            <span class="text-outline-variant">•</span>
                            <span class="font-semibold text-on-surface-variant">@item.Desi.ToString("N2") Desi</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col min-w-[240px] px-0 xl:px-4">
                    <div class="font-label-sm text-label-sm text-secondary uppercase tracking-wider mb-1">Varış Şubesi</div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[18px] text-primary">home</span>
                        <span class="font-label-lg text-label-lg text-on-surface">@item.DestinationBranchName</span>
                    </div>
                </div>

                <div class="flex flex-col min-w-[240px]">
                    <div class="flex items-center gap-2 mb-1.5">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-high text-on-surface font-label-md text-label-md">
                            @item.CargoStatus.GetDisplayName()
                        </span>
                    </div>
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-sm text-headline-sm text-on-surface font-semibold">
                            @item.EstimatedArrivalDate.ToString("dd MMM yyyy")
                        </span>
                        <span class="font-body-sm text-body-sm text-outline">Tahmini Teslimat</span>
                    </div>
                </div>

                <div class="flex items-center gap-2 pt-3 xl:pt-0 justify-end">
                    <a asp-area="User" asp-controller="Cargo" asp-action="CargoDetail" asp-route-id="@item.Id"
                       class="inline-flex items-center gap-2 h-11 px-4 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-lg text-label-lg transition-colors">
                        <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                        <span>Kargo Detayı</span>
                    </a>
                </div>

            </div>
        </article>
    }
</div>