@using CargoTrack.Business.Extensions
@using CargoTrack.Entity.Entities.Enums
@model CargoTrack.DTO.DTOs.CargosDtos.ResultCargoDto

@if (Model == null)
{
    <!-- Aktif Kargo Bulunmadığında Gözükecek Sade Alan -->
    <div class="bg-surface-container-lowest rounded-2xl p-8 border border-outline-variant/30 text-center flex flex-col items-center justify-center gap-3 shadow-sm">
        <div class="w-14 h-14 rounded-2xl bg-surface-container flex items-center justify-center text-secondary">
            <span class="material-symbols-outlined text-[32px]">inventory_2</span>
        </div>
        <div class="flex flex-col">
            <h3 class="text-base font-bold text-on-surface">Aktif Gönderiniz Bulunmuyor</h3>
            <p class="text-xs text-secondary mt-1 max-w-sm">
                Şu anda transfer veya dağıtım aşamasında bekleyen bir kargonuz yok. Geçmiş teslimatlarınızı kargo hareketlerinden inceleyebilirsiniz.
            </p>
        </div>
    </div>
}
else
{
    var statusInt = (int)Model.CargoStatus;
    var progressPercent = statusInt switch
    {
        1 => "15%",
        2 => "35%",
        3 => "55%",
        4 => "75%",
        5 => "90%",
        6 => "100%",
        _ => "20%"
    };

    <div class="bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant/30 shadow-sm flex flex-col gap-6">

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-outline-variant/20">
            <div class="flex flex-col gap-1.5">
                <div class="flex items-center gap-2.5 flex-wrap">
                    <span class="font-code text-xs font-bold px-2.5 py-1 bg-surface-container-low rounded-lg text-on-surface border border-outline-variant/30">
                        @Model.TrackCode
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold @(Model.CargoStatus == CargoStatus.OutForDelivery ? "bg-amber-500/10 text-amber-600 border border-amber-500/20" : "bg-primary/10 text-primary border border-primary/20")">
                        <span class="w-2 h-2 rounded-full @(Model.CargoStatus == CargoStatus.OutForDelivery ? "bg-amber-500 animate-ping" : "bg-primary")"></span>
                        <span>@Model.CargoStatus.GetDisplayName()</span>
                    </span>
                    <span class="text-xs text-secondary">
                        @Model.Desi.ToString("N1") Desi • @Model.Weight.ToString("N1") Kg • @Model.CargoType.ToString()
                    </span>
                </div>
                <div class="text-base font-bold text-on-surface mt-0.5">
                    @Model.OriginBranchName → @Model.DestinationBranchName
                </div>
            </div>

            <div class="flex flex-col md:text-right bg-surface-container-low md:bg-transparent p-3 md:p-0 rounded-xl">
                <span class="text-[10px] text-outline uppercase tracking-wider font-semibold">Tahmini Teslimat</span>
                <div class="text-sm sm:text-base text-primary font-bold">
                    @Model.EstimatedArrivalDate.ToString("dd MMMM yyyy • HH:mm")
                </div>
                <span class="text-xs text-secondary">Varış Şubesi: @Model.DestinationBranchName</span>
            </div>
        </div>

        <div class="py-2 px-2 sm:px-6">
            <div class="grid grid-cols-4 relative items-center gap-2">
                <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-1 bg-surface-container -z-0">
                    <div class="h-full bg-primary transition-all duration-700" style="width: @progressPercent;"></div>
                </div>

                <div class="flex flex-col items-center relative z-5 text-center gap-6">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs shadow-sm transition-all @(statusInt >= 1 ? "bg-primary text-white" : "bg-surface-container text-outline")">
                        <span class="material-symbols-outlined text-[16px]">check</span>
                    </div>
                    <span class="text-xs font-semibold @(statusInt >= 1 ? "text-on-surface" : "text-outline")">Alındı</span>
                </div>

                <div class="flex flex-col items-center relative z-10 text-center gap-6">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs shadow-sm transition-all @(statusInt >= 3 ? "bg-primary text-white" : "bg-surface-container text-outline")">
                        <span class="material-symbols-outlined text-[16px]">hub</span>
                    </div>
                    <span class="text-xs font-semibold @(statusInt >= 3 ? "text-on-surface" : "text-outline")">Transferde</span>
                </div>

                <div class="flex flex-col items-center relative z-10 text-center gap-6">
                    <div class="w-9 h-9 rounded-full flex items-center justify-center shadow-md transition-all @(statusInt == 5 ? "bg-amber-500 text-white ring-4 ring-amber-500/20 animate-pulse" : (statusInt > 5 ? "bg-primary text-white" : "bg-surface-container text-outline"))">
                        <span class="material-symbols-outlined text-[18px]">two_wheeler</span>
                    </div>
                    <span class="text-xs font-semibold @(statusInt >= 5 ? "text-primary" : "text-outline")">Dağıtımda</span>
                </div>

                <div class="flex flex-col items-center relative z-10 text-center gap-6">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs shadow-sm transition-all @(statusInt == 6 ? "bg-emerald-500 text-white" : "bg-surface-container text-outline")">
                        <span class="material-symbols-outlined text-[16px]">home</span>
                    </div>
                    <span class="text-xs font-semibold @(statusInt == 6 ? "text-emerald-600" : "text-outline")">Teslim Edildi</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

            <div class="lg:col-span-6 bg-surface-container-low p-4 rounded-xl border border-outline-variant/20 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[24px]">badge</span>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] uppercase font-bold text-outline tracking-wider">Görevli Kurye / Temsilci</span>
                        <span class="text-sm font-bold text-on-surface truncate">
                            @(!string.IsNullOrWhiteSpace(Model.AssignedCourierName) ? Model.AssignedCourierName : "Şube Transfer Ekibi")
                        </span>
                        <span class="text-xs text-secondary font-code">
                            @(!string.IsNullOrWhiteSpace(Model.AssignedCourierPhone) ? Model.AssignedCourierPhone : "Varış Şubesi Kontrolünde")
                        </span>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-6 bg-surface-container-low p-4 rounded-xl border border-outline-variant/20 flex items-center justify-between">
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase font-bold text-outline tracking-wider">Temassız Teslimat Doğrulama Kodu</span>
                    @if (Model.CargoStatus == CargoStatus.OutForDelivery && !string.IsNullOrWhiteSpace(Model.DeliveryCode))
                    {
                        <div class="flex items-center gap-2 mt-0.5">
                            <span class="font-code text-lg font-extrabold text-primary tracking-widest">
                                @Model.DeliveryCode
                            </span>
                            <span class="text-[10px] text-emerald-600 bg-emerald-500/10 px-2 py-0.5 rounded font-semibold">Aktif Kod</span>
                        </div>
                    }
                    else
                    {
                        <span class="text-xs text-secondary italic mt-1">Paket dağıtıma çıktığında kod aktifleşecektir.</span>
                    }
                </div>

                @if (Model.CargoStatus == CargoStatus.OutForDelivery && !string.IsNullOrWhiteSpace(Model.DeliveryCode))
                {
                    <button onclick="navigator.clipboard.writeText('@Model.DeliveryCode'); alert('Teslimat kodu kopyalandı!');"
                            class="h-9 px-3 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface text-xs font-semibold flex items-center gap-1.5 transition-colors border border-outline-variant/30"
                            title="Kodu Panoya Kopyala"
                            type="button">
                        <span class="material-symbols-outlined text-[16px] text-primary">content_copy</span>
                        <span>Kopyala</span>
                    </button>
                }
            </div>

        </div>

        <div class="flex items-center justify-between pt-2 border-t border-outline-variant/20">
            <span class="text-xs text-secondary">
                Teslim Adresi: <strong class="text-on-surface font-semibold">@(!string.IsNullOrWhiteSpace(Model.DeliveryAddressDetail) ? Model.DeliveryAddressDetail : "Şubeden Teslim")</strong>
            </span>
            <a asp-area="User" asp-controller="Cargo" asp-action="CargoDetail" asp-route-id="@Model.Id"
               class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
                <span>Tüm Hareket Geçmişini Gör</span>
                <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
            </a>
        </div>

    </div>
}