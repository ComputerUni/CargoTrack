<header class="fixed top-0 left-72 right-0 h-20 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-40 flex items-center justify-between px-space-xl">
    <div class="w-full max-w-md relative">
        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
        <input class="w-full h-11 pl-10 pr-4 rounded-xl bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest shadow-[0_1px_3px_rgba(15,23,42,0.04)] transition-all" placeholder="Kargo Takip No veya Gönderi Kodu girin..." type="text" />
    </div>
    <div class="flex items-center gap-space-lg">
        <div class="h-8 w-px bg-surface-container"></div>
        <div class="flex items-center gap-3">
            <div class="text-right hidden sm:block">
                <div class="font-label-lg text-label-lg text-on-surface">@ViewBag.FullName</div>
                <div class="font-body-sm text-body-sm text-secondary">@ViewBag.UserName</div>
            </div>
            <div class="w-8 h-8 rounded-full bg-primary-fixed text-on-primary-fixed-variant flex items-center justify-center font-bold text-xs uppercase select-none">
                @ViewBag.UserName.Substring(0, 1)
            </div>
        </div>
    </div>
</header>
