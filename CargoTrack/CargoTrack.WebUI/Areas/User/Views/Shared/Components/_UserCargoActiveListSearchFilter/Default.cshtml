<form method="get" asp-action="ActiveList" class="p-4 rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
    <div class="flex-1 relative">
        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
        <input name="search"
               value="@ViewBag.Search"
               class="w-full h-11 pl-10 pr-4 rounded-xl bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest transition-all"
               id="kargoSearch"
               placeholder="Takip numarası, mağaza adı veya gönderici ara..."
               type="text" />
    </div>

    <div class="flex flex-wrap items-center gap-3">
        <div class="relative">
            <select name="status"
                    onchange="this.form.submit()"
                    class="h-11 pl-3.5 pr-8 rounded-xl bg-surface-container-low text-on-surface font-label-md text-label-md appearance-none focus:outline-none cursor-pointer">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Status))">Durum: Tümü</option>
                <option value="OutForDelivery" selected="@(ViewBag.Status == "OutForDelivery")">Dağıtımda</option>
                <option value="InTransferCenter" selected="@(ViewBag.Status == "InTransferCenter")">Transfer Merkezinde</option>
                <option value="AtOriginBranch" selected="@(ViewBag.Status == "AtOriginBranch")">Çıkış Şubesinde</option>
                <option value="ArrivedAtDeliveryBranch" selected="@(ViewBag.Status == "ArrivedAtDeliveryBranch")">Varış Şubesinde</option>
            </select>
            <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">keyboard_arrow_down</span>
        </div>

        <div class="relative">
            <select name="dateRange"
                    onchange="this.form.submit()"
                    class="h-11 pl-3.5 pr-8 rounded-xl bg-surface-container-low text-on-surface font-label-md text-label-md appearance-none focus:outline-none cursor-pointer">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.DateRange))">Tüm Zamanlar</option>
                <option value="30d" selected="@(ViewBag.DateRange == "30d")">Son 30 Gün</option>
                <option value="90d" selected="@(ViewBag.DateRange == "90d")">Son 3 Ay</option>
                <option value="this_year" selected="@(ViewBag.DateRange == "this_year")">Bu Yıl (@DateTime.Now.Year)</option>
            </select>
            <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">calendar_today</span>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Search) || !string.IsNullOrEmpty(ViewBag.Status) || !string.IsNullOrEmpty(ViewBag.DateRange))
        {
            <a asp-action="ActiveList" class="h-11 px-3 flex items-center justify-center rounded-xl bg-rose-50 text-rose-600 hover:bg-rose-100 transition-colors text-xs font-semibold" title="Filtreleri Sıfırla">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </a>
        }
    </div>
</form>