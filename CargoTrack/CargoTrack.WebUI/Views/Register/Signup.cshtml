@using CargoTrack.DTO.DTOs.UserDtos
@model RegisterUserDto

@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol - CargoTrack Lojistik Ağı</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <style>
            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            .font-code {
                font-family: 'JetBrains Mono', monospace;
            }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-5xl bg-slate-800/80 backdrop-blur-xl border border-slate-700/60 rounded-3xl shadow-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-12 min-h-[700px]">

        <!-- Sol Bilgi Paneli -->
        <div class="lg:col-span-5 bg-gradient-to-br from-teal-600 via-emerald-700 to-slate-900 p-8 lg:p-12 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute -right-20 -bottom-20 w-64 h-64 bg-teal-400/20 rounded-full blur-3xl pointer-events-none"></div>

            <div>
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 bg-white text-slate-900 rounded-2xl flex items-center justify-center shadow-lg font-bold text-xl">
                        <span class="material-symbols-outlined text-[26px] text-teal-600">hub</span>
                    </div>
                    <div>
                        <span class="text-xl font-bold tracking-tight text-white block">CargoTrack</span>
                        <span class="text-xs uppercase tracking-widest text-teal-200/80 font-code font-bold">Ağ Kaydı</span>
                    </div>
                </div>

                <div class="mt-14">
                    <span class="px-3 py-1 bg-white/10 text-teal-200 rounded-full text-xs font-semibold uppercase tracking-wider backdrop-blur-sm border border-white/10">
                        Yeni Hesap
                    </span>
                    <h2 class="text-3xl font-extrabold text-white mt-4 leading-tight">
                        Lojistik Operasyonuna Katılın
                    </h2>
                    <p class="text-teal-100/80 text-sm mt-3 leading-relaxed">
                        Sistem yetkilerinizi tanımlamak ve kargo operasyonlarına erişmek için kurumsal kayıt formunu doldurunuz.
                    </p>
                </div>
            </div>

            <div class="bg-black/20 border border-white/10 p-4 rounded-2xl backdrop-blur-md mt-8">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-teal-400">shield_person</span>
                    <div class="text-xs">
                        <p class="font-bold text-white">Rol Tabanlı Yetkilendirme</p>
                        <p class="text-slate-300">Şube personeli ve kurye atamaları yönetici onayına tabidir.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Form Paneli -->
        <div class="lg:col-span-7 p-8 lg:p-14 flex flex-col justify-center bg-slate-800">
            <div class="max-w-lg w-full mx-auto">

                <div class="mb-6">
                    <h3 class="text-2xl font-bold text-white tracking-tight">Kullanıcı Kayıt Formu</h3>
                    <p class="text-slate-400 text-sm mt-1">Lütfen tüm alanları eksiksiz doldurunuz.</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 p-4 bg-rose-500/10 border border-rose-500/30 rounded-2xl text-rose-400 text-xs">
                        <div asp-validation-summary="All" class="space-y-1"></div>
                    </div>
                }

                <form method="post" class="space-y-4">

                    <!-- Ad & Soyad -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Ad</label>
                            <input type="text" asp-for="FirstName" placeholder="örn: Hasan"
                                   class="w-full h-11 px-4 bg-slate-900/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-teal-500 text-sm font-medium" />
                            <span class="text-rose-400 text-xs mt-1 block" asp-validation-for="FirstName"></span>
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Soyad</label>
                            <input type="text" asp-for="LastName" placeholder="örn: Yıldırım"
                                   class="w-full h-11 px-4 bg-slate-900/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-teal-500 text-sm font-medium" />
                            <span class="text-rose-400 text-xs mt-1 block" asp-validation-for="LastName"></span>
                        </div>
                    </div>

                    <!-- Email & Kullanıcı Adı -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">E-Posta</label>
                            <input type="email" asp-for="Email" placeholder="hasan@cargotrack.com"
                                   class="w-full h-11 px-4 bg-slate-900/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-teal-500 text-sm font-medium" />
                            <span class="text-rose-400 text-xs mt-1 block" asp-validation-for="Email"></span>
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Kullanıcı Adı</label>
                            <input type="text" asp-for="UserName" placeholder="hasan.yildirim"
                                   class="w-full h-11 px-4 bg-slate-900/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-teal-500 text-sm font-medium" />
                            <span class="text-rose-400 text-xs mt-1 block" asp-validation-for="UserName"></span>
                        </div>
                    </div>

                    <!-- Şifreler -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Şifre</label>
                            <input type="password" asp-for="Password" placeholder="••••••••"
                                   class="w-full h-11 px-4 bg-slate-900/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-teal-500 text-sm font-medium" />
                            <span class="text-rose-400 text-xs mt-1 block" asp-validation-for="Password"></span>
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Şifre Tekrarı</label>
                            <input type="password" asp-for="ConfirmPassword" placeholder="••••••••"
                                   class="w-full h-11 px-4 bg-slate-900/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-teal-500 text-sm font-medium" />
                            <span class="text-rose-400 text-xs mt-1 block" asp-validation-for="ConfirmPassword"></span>
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full h-12 mt-2 bg-teal-500 hover:bg-teal-600 text-slate-950 font-bold rounded-xl shadow-lg shadow-teal-500/20 transition-all flex items-center justify-center gap-2 group cursor-pointer">
                        <span>Kaydı Tamamla</span>
                        <span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform">how_to_reg</span>
                    </button>
                </form>

                <div class="mt-6 pt-4 border-t border-slate-700/60 text-center">
                    <p class="text-sm text-slate-400">
                        Zaten bir hesabınız var mı?
                        <a asp-controller="Login" asp-action="Index" class="text-teal-400 font-bold hover:underline ml-1">Giriş Yap</a>
                    </p>
                </div>

            </div>
        </div>

    </div>

</body>
</html>