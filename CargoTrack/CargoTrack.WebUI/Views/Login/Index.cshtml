@using CargoTrack.DTO.DTOs.UserDtos
@model LoginUserDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Giriş Sayfası</h1>

<form method="post">
    <div class="container mt-3">
        <label>Kullanıcı Adı</label>
        <input type="text" asp-for="UserName" class="form-control" required />
    </div>
    <div class="container mt-3">
        <label>Şifre</label>
        <input type="password" asp-for="Password" class="form-control" required />
    </div>
    <div class="text-danger" asp-validation-summary="All"></div>
    <div class="mt-3">
        <button class="btn btn-outline-dark">Giris Yap</button>
    </div>
</form>
