@using CargoTrack.DTO.DTOs.UserDtos
@model LoginUserDto

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - CargoTrack Lojistik Ağı</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <style>
            body { font-family: 'Plus Jakarta Sans', sans-serif; }
            .font-code { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-5xl bg-slate-800/80 backdrop-blur-xl border border-slate-700/60 rounded-3xl shadow-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-12 min-h-[640px]">
        <div class="lg:col-span-5 bg-gradient-to-br from-emerald-600 via-teal-700 to-slate-900 p-8 lg:p-12 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-emerald-400/20 rounded-full blur-3xl pointer-events-none"></div>
            <div>
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 bg-white text-slate-900 rounded-2xl flex items-center justify-center shadow-lg shadow-black/20 font-bold text-xl">
                        <span class="material-symbols-outlined text-[26px] text-emerald-600">local_shipping</span>
                    </div>
                    <div>
                        <span class="text-xl font-bold tracking-tight text-white block">CargoTrack</span>
                        <span class="text-xs uppercase tracking-widest text-emerald-200/80 font-code font-bold">Lojistik Ağı</span>
                    </div>
                </div>

                <div class="mt-14">
                    <span class="px-3 py-1 bg-white/10 text-emerald-200 rounded-full text-xs font-semibold uppercase tracking-wider backdrop-blur-sm border border-white/10">
                        Güvenli Terminal Portalı
                    </span>
                    <h2 class="text-3xl font-extrabold text-white mt-4 leading-tight">
                        Sevkiyat ve Dağıtım Yönetimi
                    </h2>
                    <p class="text-emerald-100/80 text-sm mt-3 leading-relaxed">
                        Şubeler arası anlık aktarım takibi, SMS doğrulama terminali ve güvenli kargo kabul noktası.
                    </p>
                </div>
            </div>
            <div class="bg-black/20 border border-white/10 p-4 rounded-2xl backdrop-blur-md mt-8">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-emerald-400">verified_user</span>
                    <div class="text-xs">
                        <p class="font-bold text-white">End-to-End Audit Trail</p>
                        <p class="text-slate-300">Tüm hareket kayıtları değiştirilemez günlükte tutulur.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="lg:col-span-7 p-8 lg:p-14 flex flex-col justify-center bg-slate-800">
            <div class="max-w-md w-full mx-auto">

                <div class="mb-8">
                    <h3 class="text-2xl font-bold text-white tracking-tight">Kullanıcı Girişi</h3>
                    <p class="text-slate-400 text-sm mt-1">Sisteme devam etmek için yetkili bilgilerinizi giriniz.</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 p-4 bg-rose-500/10 border border-rose-500/30 rounded-2xl text-rose-400 text-sm">
                        <div asp-validation-summary="All" class="space-y-1"></div>
                    </div>
                }

                <form method="post" class="space-y-5">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Kullanıcı Adı</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500 text-[20px] pointer-events-none">
                                person
                            </span>
                            <input type="text" asp-for="UserName" required autocomplete="username"
                                   placeholder="örn: ahmet.demir"
                                   class="w-full h-12 pl-11 pr-4 bg-slate-900/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all font-medium text-sm" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Şifre</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500 text-[20px] pointer-events-none">
                                key
                            </span>
                            <input type="password" asp-for="Password" required autocomplete="current-password"
                                   placeholder="••••••••"
                                   class="w-full h-12 pl-11 pr-4 bg-slate-900/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all font-medium text-sm" />
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full h-12 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold rounded-xl shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2 group cursor-pointer">
                        <span>Oturum Aç</span>
                        <span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
                    </button>
                </form>

                <div class="mt-8 pt-6 border-t border-slate-700/60 text-center">
                    <p class="text-sm text-slate-400">
                        Hesabınız yok mu?
                        <a asp-controller="Register" asp-action="Signup" class="text-emerald-400 font-bold hover:underline ml-1">Kayıt Ol</a>
                    </p>
                </div>

            </div>
        </div>

    </div>

</body>
</html>